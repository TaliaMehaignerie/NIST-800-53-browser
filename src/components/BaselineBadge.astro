---
// DESIGN.md `baseline-badge`: one pill per Baseline, semantic color as
// low-opacity background with matching text color (never white-on-color).
interface Props {
  baseline: 'low' | 'moderate' | 'high' | 'privacy';
}

const { baseline } = Astro.props;

const label = { low: 'Low', moderate: 'Moderate', high: 'High', privacy: 'Privacy' }[baseline] ?? baseline;
---

<span class={`baseline-badge baseline-badge--${baseline}`}>{label}</span>

<style>
  .baseline-badge {
    display: inline-block;
    border-radius: var(--rounded-full);
    font-family: var(--font-meta);
    font-size: 13px;
    line-height: 1.4;
    padding: 2px 8px;
  }

  .baseline-badge--low {
    background: color-mix(in srgb, var(--color-baseline-low) 20%, transparent);
    color: var(--color-baseline-low);
  }

  .baseline-badge--moderate {
    background: color-mix(in srgb, var(--color-baseline-moderate) 20%, transparent);
    color: var(--color-baseline-moderate);
  }

  .baseline-badge--high {
    background: color-mix(in srgb, var(--color-baseline-high) 20%, transparent);
    color: var(--color-baseline-high);
  }

  .baseline-badge--privacy {
    background: color-mix(in srgb, var(--color-baseline-privacy) 20%, transparent);
    color: var(--color-baseline-privacy);
  }
</style>
