---
// Story 13: the one status control (AD-14), used on the Control detail page
// and inside every Enhancement fragment — never two implementations. Status
// is per-system, keyed by item slug, independent of the working baseline.
// Hidden until the script runs: with JS disabled the page is unchanged.
// `data-pagefind-ignore` keeps form labels out of the search index.
interface Props {
  slug: string;
}

const { slug } = Astro.props;
const OPTIONS: { value: string; label: string }[] = [
  { value: 'incomplete', label: 'Incomplete' },
  { value: 'in-progress', label: 'In progress' },
  { value: 'compliant', label: 'Compliant' },
  { value: 'not-applicable', label: 'Not applicable' },
];
---

<div class="status-control" data-status-control data-item-slug={slug} data-pagefind-ignore hidden>
  <div class="status-control__row">
    <label for={`status-${slug}`}>Status</label>
    <select id={`status-${slug}`} data-status-select>
      {OPTIONS.map((o) => <option value={o.value}>{o.label}</option>)}
    </select>
    <label for={`owner-${slug}`}>Owner</label>
    <input id={`owner-${slug}`} type="text" data-status-owner />
  </div>
  <div class="status-control__gate" role="status" hidden data-status-gate>
    <span data-gate-text></span>
    <a data-gate-link>Open the unreviewed parameters in the workspace</a>
  </div>
  <div class="status-control__justification" data-status-justification-wrap hidden>
    <div class="status-control__row">
      <label for={`jtype-${slug}`}>Reason</label>
      <select id={`jtype-${slug}`} data-status-jtype>
        <option value="other">Other (explain below)</option>
        <option value="inherited">Inherited from a provider</option>
      </select>
      <input type="text" data-status-provider placeholder="Provider name" aria-label="Provider this is inherited from" hidden />
    </div>
    <label for={`justification-${slug}`} data-status-justification-label>Justification (required for not applicable)</label>
    <textarea id={`justification-${slug}`} rows="2" data-status-justification></textarea>
  </div>
  <div class="status-control__evidence">
    <p class="status-control__evidence-title">Evidence</p>
    <ul class="status-control__evidence-list" data-evidence-list></ul>
    <button type="button" data-evidence-add>Add evidence</button>
  </div>
  <p class="status-control__error" role="alert" hidden data-status-error></p>
  <div class="status-control__actions">
    <button type="button" data-status-save>Save status</button>
    <span class="status-control__saved" role="status" data-status-saved></span>
  </div>
</div>

<style>
  .status-control {
    font-family: var(--font-meta);
    font-size: 13px;
    color: var(--color-ink-secondary);
    border: 1px solid var(--color-border-hairline);
    border-radius: var(--rounded-sm);
    padding: 8px 12px;
    margin: 0 0 16px;
  }

  .status-control[hidden] {
    display: none;
  }

  .status-control__row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .status-control__justification {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 8px;
  }

  .status-control__gate {
    margin-top: 8px;
    padding: 4px 8px;
    color: var(--color-ink-primary);
    background: var(--color-surface-overlay);
    border-left: 3px solid var(--color-accent);
  }

  .status-control__gate[hidden] {
    display: none;
  }

  .status-control__gate a {
    margin-left: 6px;
  }

  .status-control input[hidden] {
    display: none;
  }

  .status-control__justification[hidden] {
    display: none;
  }

  .status-control select,
  .status-control input,
  .status-control textarea {
    font: inherit;
    color: var(--color-ink-primary);
    background: var(--color-surface-overlay);
    border: 1px solid var(--color-border-hairline);
    border-radius: var(--rounded-sm);
    padding: 3px 6px;
  }

  .status-control textarea {
    width: 100%;
  }

  .status-control select:focus-visible,
  .status-control input:focus-visible,
  .status-control textarea:focus-visible,
  .status-control button:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .status-control__evidence {
    margin-top: 10px;
  }

  .status-control__evidence-title {
    margin: 0 0 4px;
    font-weight: 600;
  }

  .status-control__evidence-list {
    list-style: none;
    margin: 0 0 6px;
    padding: 0;
  }

  .status-control__evidence-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 6px 0;
    border-top: 1px solid var(--color-border-hairline);
  }

  .status-control__evidence-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .status-control__evidence-item textarea,
  .status-control__evidence-item input {
    width: 100%;
  }

  .status-control__error {
    margin: 8px 0 0;
    padding: 4px 8px;
    color: var(--color-ink-primary);
    background: var(--color-surface-overlay);
    border-left: 3px solid var(--color-ink-secondary);
  }

  .status-control__actions {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 8px;
  }

  .status-control button {
    font: inherit;
    color: var(--color-ink-primary);
    background: var(--color-surface-overlay);
    border: none;
    border-radius: var(--rounded-sm);
    padding: 5px 12px;
    cursor: pointer;
  }

  .status-control button:hover {
    background: var(--color-border-hairline);
  }
</style>

<script>
  import {
    getStatus,
    inheritedJustification,
    setStatus,
    isItemStatus,
    isSafeEvidenceUrl,
    statusProblem,
    EVIDENCE_LIMIT_MESSAGE,
    MAX_EVIDENCE_NOTE_LENGTH,
    MAX_EVIDENCE_REFS,
    type EvidenceInput,
    type EvidenceRef,
    type ItemStatus,
  } from '../utils/statusStore';
  import { onOdpStorageChange, WORKBENCH_DATA_EVENT } from '../utils/storageSync';
  import { ACTIVE_BASELINE_EVENT, getActiveBaseline } from '../utils/activeBaseline';
  import { getDecisions } from '../utils/odpStore';
  import { blockMessage, interlockFor, PAYLOAD_UNAVAILABLE_MESSAGE, staleCompliantMessage } from '../utils/odpInterlock';
  import { readSlotPayload } from '../utils/slotPayload';
  import { workspaceUrl } from '../utils/url';

  const SAVE_FAILED = 'Could not save this status. Your browser storage may be full or unavailable.';

  function parts(root: HTMLElement) {
    return {
      slug: root.dataset.itemSlug ?? '',
      select: root.querySelector<HTMLSelectElement>('[data-status-select]')!,
      owner: root.querySelector<HTMLInputElement>('[data-status-owner]')!,
      wrap: root.querySelector<HTMLElement>('[data-status-justification-wrap]')!,
      justification: root.querySelector<HTMLTextAreaElement>('[data-status-justification]')!,
      jtype: root.querySelector<HTMLSelectElement>('[data-status-jtype]')!,
      provider: root.querySelector<HTMLInputElement>('[data-status-provider]')!,
      justificationLabel: root.querySelector<HTMLElement>('[data-status-justification-label]')!,
      evidenceList: root.querySelector<HTMLElement>('[data-evidence-list]')!,
      evidenceAdd: root.querySelector<HTMLButtonElement>('[data-evidence-add]')!,
      gate: root.querySelector<HTMLElement>('[data-status-gate]')!,
      gateText: root.querySelector<HTMLElement>('[data-gate-text]')!,
      gateLink: root.querySelector<HTMLAnchorElement>('[data-gate-link]')!,
      error: root.querySelector<HTMLElement>('[data-status-error]')!,
      saved: root.querySelector<HTMLElement>('[data-status-saved]')!,
      save: root.querySelector<HTMLButtonElement>('[data-status-save]')!,
    };
  }

  // One evidence row. Note and URL are user input: set via .value/.textContent
  // only, and the URL becomes a link only when it is a safe http(s) URL.
  // `collectedAt` is shown, never editable and never sent: the store keeps it
  // for an unchanged reference and stamps a new or edited one.
  function buildEvidenceRow(ref?: EvidenceRef): HTMLElement {
    const li = document.createElement('li');
    li.className = 'status-control__evidence-item';
    li.dataset.evidenceRow = 'true';

    const note = document.createElement('textarea');
    note.rows = 2;
    note.maxLength = MAX_EVIDENCE_NOTE_LENGTH;
    note.value = ref?.note ?? '';
    note.setAttribute('aria-label', 'Evidence note');
    note.dataset.evidenceNote = 'true';

    const url = document.createElement('input');
    url.type = 'text';
    url.value = ref?.url ?? '';
    url.placeholder = 'https://… (optional)';
    url.setAttribute('aria-label', 'Evidence URL (optional)');
    url.dataset.evidenceUrl = 'true';

    const meta = document.createElement('div');
    meta.className = 'status-control__evidence-meta';
    const collected = document.createElement('span');
    const link = document.createElement('a');
    link.target = '_blank';
    link.rel = 'noopener noreferrer';
    link.textContent = 'Open link';
    meta.append(collected, link);

    // The date and link describe what is SAVED. Once the row is edited they
    // would be stale, so say the row will be re-dated and drop the old link.
    const refreshMeta = () => {
      const unchanged = ref !== undefined && note.value.trim() === ref.note && url.value.trim() === ref.url;
      collected.textContent = !ref
        ? 'New — dated when saved'
        : unchanged
          ? `Collected ${new Date(ref.collectedAt).toLocaleDateString()}`
          : 'Edited — re-dated when saved';
      link.hidden = !(unchanged && isSafeEvidenceUrl(ref.url));
      if (!link.hidden && ref) link.href = ref.url;
    };
    refreshMeta();
    note.addEventListener('input', refreshMeta);
    url.addEventListener('input', refreshMeta);
    const remove = document.createElement('button');
    remove.type = 'button';
    remove.textContent = 'Remove';
    remove.addEventListener('click', () => {
      const root = li.closest<HTMLElement>('[data-status-control]');
      li.remove();
      if (root) markDirty(root);
    });
    meta.appendChild(remove);

    li.append(note, url, meta);
    return li;
  }

  function markDirty(root: HTMLElement): void {
    root.dataset.dirty = 'true';
    parts(root).error.hidden = true;
  }

  function readEvidence(root: HTMLElement): EvidenceInput[] {
    const inputs: EvidenceInput[] = [];
    root.querySelectorAll<HTMLElement>('[data-evidence-row]').forEach((li) => {
      const note = li.querySelector<HTMLTextAreaElement>('[data-evidence-note]')!.value;
      const url = li.querySelector<HTMLInputElement>('[data-evidence-url]')!.value;
      if (note.trim().length === 0 && url.trim().length === 0) return;
      inputs.push({ note, url });
    });
    return inputs;
  }

  function syncJustification(root: HTMLElement): void {
    const p = parts(root);
    p.wrap.hidden = p.select.value !== 'not-applicable';
    const inherited = p.jtype.value === 'inherited';
    p.provider.hidden = !inherited;
    p.justificationLabel.textContent = inherited ? 'Details (optional)' : 'Justification (required for not applicable)';
  }

  // Story 15: the ODP interlock. The item's parameters come from the page's
  // embedded payload (never the dataset) and their statuses from odpStore for
  // the working baseline. Only a move INTO compliant is blocked; an item that
  // is already compliant gets a note instead, so a baseline switch can never
  // trap edits to its owner or evidence.
  // `null` means the page's parameters could not be read. The interlock then
  // fails CLOSED (no move into compliant) rather than silently open.
  const pagePayload = readSlotPayload();

  function gateOf(slug: string) {
    const baseline = getActiveBaseline();
    const control = pagePayload?.controls[slug];
    const item = control ? { slug, baselines: control.baselines, paramIds: Object.keys(control.params) } : undefined;
    return interlockFor(item, baseline, getDecisions(baseline));
  }

  function enteringCompliant(root: HTMLElement): boolean {
    const p = parts(root);
    return p.select.value === 'compliant' && getStatus(p.slug)?.status !== 'compliant';
  }

  function updateGate(root: HTMLElement): void {
    const p = parts(root);
    if (!pagePayload) {
      const blockedNoPayload = enteringCompliant(root);
      p.save.disabled = blockedNoPayload;
      p.gate.hidden = !blockedNoPayload;
      p.gateText.textContent = PAYLOAD_UNAVAILABLE_MESSAGE;
      p.gateLink.hidden = true;
      return;
    }
    p.gateLink.hidden = false;
    const gate = gateOf(p.slug);
    const blocked = gate.blocked && enteringCompliant(root);
    // Tied to the STORED status, not the draft select, so it doesn't flicker as the form is edited.
    const stale = gate.blocked && getStatus(p.slug)?.status === 'compliant';

    p.save.disabled = blocked;
    p.gate.hidden = !(blocked || stale);
    if (p.gate.hidden) return;
    p.gateText.textContent = blocked
      ? `${blockMessage(gate)} Choose another status to save your other changes.`
      : staleCompliantMessage(gate);
    const url = new URL(workspaceUrl(gate.baseline), window.location.origin);
    url.searchParams.set('view', 'individual');
    url.searchParams.set('family', pagePayload?.controls[p.slug]?.familyCode ?? '');
    url.searchParams.set('unreviewed', '1');
    p.gateLink.href = url.toString();
  }

  // Fills the form from storage. `force` is for first paint; a cross-tab
  // refresh only touches controls whose stored record actually changed, so
  // typing in an unrelated item is never clobbered.
  function populate(root: HTMLElement, force: boolean): void {
    const p = parts(root);
    const record = getStatus(p.slug);
    const snapshot = JSON.stringify(record ?? null);
    if (!force && root.dataset.snapshot === snapshot) return;
    // Unsaved edits win over a passive cross-tab refresh; the next save
    // (or reload) reconciles with storage.
    if (!force && root.dataset.dirty === 'true') return;
    root.dataset.snapshot = snapshot;
    delete root.dataset.dirty;

    p.select.value = record?.status ?? 'incomplete';
    p.owner.value = record?.owner ?? '';
    const inheritedFrom = record?.inheritedFrom ?? '';
    p.jtype.value = inheritedFrom ? 'inherited' : 'other';
    p.provider.value = inheritedFrom;
    // For an inherited N/A the default justification is just the provider line, so show details only if the user added some.
    p.justification.value =
      inheritedFrom && record?.justification === inheritedJustification(inheritedFrom, '') ? '' : (record?.justification ?? '');
    p.evidenceList.replaceChildren(...(record?.evidence ?? []).map((ref) => buildEvidenceRow(ref)));
    p.error.hidden = true;
    p.saved.textContent = record ? `Last updated ${new Date(record.updatedAt).toLocaleString()}` : '';
    syncJustification(root);
    updateGate(root);
  }

  function save(root: HTMLElement): void {
    const p = parts(root);
    p.error.hidden = true;
    p.error.textContent = '';

    const status: ItemStatus = isItemStatus(p.select.value) ? p.select.value : 'incomplete';
    const inherited = status === 'not-applicable' && p.jtype.value === 'inherited';
    const inheritedFrom = inherited ? p.provider.value.trim() : undefined;
    let justification = '';
    if (status === 'not-applicable') {
      justification = inheritedFrom ? inheritedJustification(inheritedFrom, p.justification.value) : p.justification.value;
    }
    const evidence = readEvidence(root);
    // Defense in depth: the Save button is disabled while blocked, but the
    // rule is enforced here too.
    if (enteringCompliant(root)) {
      const gate = gateOf(p.slug);
      if (!pagePayload || gate.blocked) {
        p.error.textContent = pagePayload ? blockMessage(gate) : PAYLOAD_UNAVAILABLE_MESSAGE;
        p.error.hidden = false;
        updateGate(root);
        return;
      }
    }
    const ok = setStatus(p.slug, { status, owner: p.owner.value.trim(), justification, inheritedFrom, evidence });
    if (!ok) {
      p.error.textContent = statusProblem({ status, justification, inheritedFrom, evidence }) ?? SAVE_FAILED;
      p.error.hidden = false;
      return;
    }
    populate(root, true);
    window.dispatchEvent(new CustomEvent(WORKBENCH_DATA_EVENT));
  }

  const controls = Array.from(document.querySelectorAll<HTMLElement>('[data-status-control]'));
  controls.forEach((root) => {
    populate(root, true);
    root.hidden = false;
    const p = parts(root);
    p.select.addEventListener('change', () => {
      markDirty(root);
      syncJustification(root);
      updateGate(root);
    });
    p.jtype.addEventListener('change', () => {
      markDirty(root);
      syncJustification(root);
    });
    p.provider.addEventListener('input', () => markDirty(root));
    p.owner.addEventListener('input', () => markDirty(root));
    p.justification.addEventListener('input', () => markDirty(root));
    p.evidenceList.addEventListener('input', () => markDirty(root));
    p.evidenceAdd.addEventListener('click', () => {
      if (p.evidenceList.children.length >= MAX_EVIDENCE_REFS) {
        p.error.textContent = EVIDENCE_LIMIT_MESSAGE;
        p.error.hidden = false;
        return;
      }
      const row = buildEvidenceRow();
      p.evidenceList.appendChild(row);
      row.querySelector<HTMLTextAreaElement>('[data-evidence-note]')?.focus();
      markDirty(root);
    });
    p.save.addEventListener('click', () => save(root));
  });

  // The gate depends on the stored status, so it is re-evaluated even when
  // `populate` leaves a dirty form alone.
  onOdpStorageChange(
    () =>
      controls.forEach((root) => {
        populate(root, false);
        updateGate(root);
      }),
    {
    baseline: false,
    decisions: false,
    status: true,
    },
  );

  // The verdict follows the parameters it reads: a decision made in the
  // popover here, in another tab, or a working-baseline switch re-evaluates it.
  const refreshGates = () => controls.forEach((root) => updateGate(root));
  window.addEventListener('odpdecisionschanged', refreshGates);
  window.addEventListener(ACTIVE_BASELINE_EVENT, refreshGates);
  onOdpStorageChange(refreshGates);
</script>
