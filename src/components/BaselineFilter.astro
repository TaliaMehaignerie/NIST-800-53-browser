---
// DESIGN.md "Baseline filter": single-select toggle group (All / Low /
// Moderate / High / Privacy). Mounted opt-in per page (BaseLayout's
// `showBaselineFilter` prop, spec-search-baseline-integration) only where
// it has something to act on: Family Detail and Control Detail (their own
// DOM-based `[data-baselines]` filtering, unchanged) and /search, where it
// instead drives Pagefind-native filtering via a `baselinefilterchange`
// CustomEvent that SearchBox listens for. Home never mounts it. Inactive
// pills are plain meta text; the active pill gets a surface-overlay pill
// background — same grammar as a Baseline badge.
const BASELINES: { value: string | null; label: string }[] = [
  { value: null, label: 'All' },
  { value: 'low', label: 'Low' },
  { value: 'moderate', label: 'Moderate' },
  { value: 'high', label: 'High' },
  { value: 'privacy', label: 'Privacy' },
];
---

<p class="baseline-filter-compact" data-filter-compact hidden>
  <span data-filter-compact-text></span>
  <button type="button" class="baseline-filter-compact__toggle" data-filter-compact-toggle></button>
</p>
<div class="baseline-filter" role="group" aria-label="Filter by Baseline" data-filter-pills>
  <span class="baseline-filter__label">Viewing</span>
  {BASELINES.map(({ value, label }) => (
    <button type="button" class="filter-pill" data-baseline={value ?? ''} aria-pressed="false">
      {label}
    </button>
  ))}
</div>

<style>
  .baseline-filter-compact {
    font-family: var(--font-meta);
    font-size: 13px;
    color: var(--color-ink-secondary);
    margin: 0;
  }

  .baseline-filter-compact[hidden],
  .baseline-filter[hidden] {
    display: none;
  }

  .baseline-filter-compact__toggle {
    font: inherit;
    color: var(--color-accent);
    background: none;
    border: none;
    padding: 0 0 0 6px;
    cursor: pointer;
    text-decoration: underline;
  }

  .baseline-filter-compact__toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .baseline-filter {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .baseline-filter {
    align-items: center;
  }

  .baseline-filter__label {
    font-family: var(--font-meta);
    font-size: 13px;
    color: var(--color-ink-secondary);
    margin-right: 2px;
  }

  .filter-pill {
    font-family: var(--font-meta);
    font-size: 13px;
    color: var(--color-ink-secondary);
    background: transparent;
    border: none;
    border-radius: var(--rounded-full);
    padding: 4px 12px;
    cursor: pointer;
  }

  .filter-pill:hover {
    background: var(--color-surface-overlay);
  }

  .filter-pill.active {
    background: var(--color-surface-overlay);
    color: var(--color-ink-primary);
  }

  .filter-pill:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>

<script>
  import { setUrlState } from '../utils/urlState';
  import { baselineLabel } from '../utils/activeBaseline';
  import { defaultViewBaseline, viewBaseline, viewParam } from '../utils/viewFilter';

  // Derived from the rendered pills rather than a second hardcoded list, so
  // there's exactly one source of truth for "which baselines exist" (the
  // server-rendered BASELINES array in this same file's frontmatter).
  const VALID_BASELINES = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-pill'))
    .map((pill) => pill.dataset.baseline)
    .filter((v): v is string => Boolean(v));

  // `?baseline=` resolution is shared with search (`viewFilter.ts`): once your
  // system's baseline is chosen it is the default, and `all` shows everything.
  function currentBaseline(): string | null {
    const value = viewBaseline();
    return value && VALID_BASELINES.includes(value) ? value : null;
  }

  // Pre-hydration paint is always the full unfiltered list (EXPERIENCE.md
  // "Pre-hydration filter flash" -- accepted as-is for v1); this is the
  // client-side effect that narrows it once the script runs. Also toggles a
  // sibling `.baseline-empty-state` message per row-group when a filter
  // matches zero rows in that group (e.g. a Family with no Low-baseline
  // Controls) -- confirmed a real case (PM/PT families have zero Low/
  // Moderate/High controls), not just theoretical.
  function applyFilter(baseline: string | null) {
    const groups = new Map<Element, { total: number; visible: number }>();
    document.querySelectorAll<HTMLElement>('[data-baselines]').forEach((el) => {
      const values = (el.dataset.baselines ?? '').split(' ').filter(Boolean);
      const visible = !baseline || values.includes(baseline);
      el.style.display = visible ? '' : 'none';
      const parent = el.parentElement;
      if (parent) {
        const g = groups.get(parent) ?? { total: 0, visible: 0 };
        g.total += 1;
        if (visible) g.visible += 1;
        groups.set(parent, g);
      }
    });
    groups.forEach((g, parent) => {
      const emptyState = parent.nextElementSibling;
      if (emptyState?.classList.contains('baseline-empty-state')) {
        (emptyState as HTMLElement).hidden = !(g.total > 0 && g.visible === 0);
      }
    });
  }

  function markActivePill(baseline: string | null) {
    document.querySelectorAll<HTMLButtonElement>('.filter-pill').forEach((pill) => {
      const value = pill.dataset.baseline || null;
      const active = value === baseline;
      pill.classList.toggle('active', active);
      pill.setAttribute('aria-pressed', String(active));
    });
  }

  // Carries the active filter across a full navigation (UJ-1: filter on
  // Home, land on a Family page still filtered) by appending it to
  // same-content internal links found on the current page -- the only way
  // state survives a full MPA navigation with no client router (AD-1).
  function updateLinks(baseline: string | null) {
    document
      .querySelectorAll<HTMLAnchorElement>('main a[href*="/families/"], main a[href*="/controls/"]')
      .forEach((a) => {
        const url = new URL(a.href);
        const param = viewParam(baseline);
        if (param) url.searchParams.set('baseline', param);
        else url.searchParams.delete('baseline');
        a.href = url.toString();
      });
  }

  function setFilter(next: string | null) {
    setUrlState({ search: { baseline: viewParam(next) } });
    markActivePill(next);
    applyFilter(next);
    updateLinks(next);
    renderCompact(next);
    // Decoupled signal for /search's Pagefind-native filtering
    // (SearchBox.astro) -- BaselineFilter doesn't need to know SearchBox
    // exists. No effect on Family/Control pages beyond the event firing.
    window.dispatchEvent(new CustomEvent('baselinefilterchange', { detail: { baseline: next } }));
  }

  // Once your baseline is chosen the five pills are noise: one quiet line says
  // what you are seeing and offers the other view.
  function renderCompact(current: string | null) {
    const mine = defaultViewBaseline();
    const compact = document.querySelector<HTMLElement>('[data-filter-compact]');
    const pills = document.querySelector<HTMLElement>('[data-filter-pills]');
    if (!compact || !pills) return;
    compact.hidden = mine === null;
    pills.hidden = mine !== null;
    if (mine === null) return;
    compact.querySelector<HTMLElement>('[data-filter-compact-text]')!.textContent =
      current === null ? 'Showing all controls ·' : `Showing ${baselineLabel(current)} controls ·`;
    compact.querySelector<HTMLElement>('[data-filter-compact-toggle]')!.textContent =
      current === mine ? 'Show all controls' : `Show only ${baselineLabel(mine)} controls`;
  }

  function init() {
    const baseline = currentBaseline();
    markActivePill(baseline);
    applyFilter(baseline);
    updateLinks(baseline);
    renderCompact(baseline);

    document.querySelector<HTMLButtonElement>('[data-filter-compact-toggle]')?.addEventListener('click', () => {
      const mine = defaultViewBaseline();
      setFilter(currentBaseline() === mine ? null : mine);
    });

    document.querySelectorAll<HTMLButtonElement>('.filter-pill').forEach((pill) => {
      pill.addEventListener('click', () => {
        const value = pill.dataset.baseline || null;
        const active = currentBaseline();
        // Clicking "All" (value === null) always clears. Clicking the
        // currently-active specific pill again also clears.
        const next = value === active ? null : value;
        setFilter(next);
      });
    });
  }

  init();
</script>
