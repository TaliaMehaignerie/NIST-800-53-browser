---
// DESIGN.md "Enhancement toggle" — collapsed by default (CAP-3): header
// (chevron, id, title, badge/Withdrawn marker) always renders; the statement
// body is hidden until expanded via click/tap or keyboard, and the most
// recently opened Enhancement's slug is tracked in `location.hash` via the
// shared `setUrlState()` helper (AD-3). Own Baseline badges/Withdrawn marker,
// since an Enhancement's baseline membership may differ from its parent
// Control's (architecture AD-2).
import BaselineBadge from './BaselineBadge.astro';
import WithdrawnMarker from './WithdrawnMarker.astro';
import StatementTree from './StatementTree.astro';

interface StatementNode {
  label: string | null;
  prose: string | null;
  children: StatementNode[];
}

interface Param {
  id: string;
  label: string | null;
  select: { howMany: string | null; choice: string[] } | null;
  guidelines: string[];
}

interface Props {
  slug: string;
  label: string;
  title: string;
  withdrawn: boolean;
  incorporatedInto: string[];
  baselines: ('low' | 'moderate' | 'high' | 'privacy')[];
  statement: StatementNode[];
  params: Param[];
}

const { slug, label, title, withdrawn, incorporatedInto, baselines, statement, params } = Astro.props;
---

{
  /*
   * 157 real Enhancements (mostly withdrawn ones) have no statement, so
   * clicking their header would flip a chevron and reveal nothing -- the
   * toggle affordance (chevron, role, tabindex, aria-expanded) only appears
   * when there's a body to expand.
   */
}
<div class="enhancement-item" id={slug} data-baselines={baselines.join(' ')}>
  <div
    class="enhancement-item__header"
    role={statement.length > 0 ? 'button' : undefined}
    tabindex={statement.length > 0 ? 0 : undefined}
    aria-expanded={statement.length > 0 ? 'false' : undefined}
    aria-controls={statement.length > 0 ? `${slug}-statement` : undefined}
  >
    {statement.length > 0 && (
      <svg class="enhancement-item__chevron" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
        <path d="M3 2 L9 6 L3 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    )}
    <span class="enhancement-item__id">{label}</span>
    <span class={`enhancement-item__title ${withdrawn ? 'enhancement-item__title--withdrawn' : ''}`}>
      {title}
    </span>
    <span class="enhancement-item__badges">
      {withdrawn ? (
        <WithdrawnMarker incorporatedInto={incorporatedInto} showSuccessors />
      ) : baselines.length > 0 ? (
        baselines.map((b) => <BaselineBadge baseline={b} />)
      ) : (
        <span class="enhancement-item__no-baseline">Not in a baseline</span>
      )}
    </span>
  </div>
  {statement.length > 0 && (
    <div class="enhancement-item__statement" id={`${slug}-statement`} hidden>
      <StatementTree nodes={statement} params={params} />
    </div>
  )}
</div>

<style>
  .enhancement-item {
    border-radius: var(--rounded-sm);
    background: var(--color-surface-overlay);
    padding: 12px 16px;
    margin-bottom: 8px;
  }

  .enhancement-item__header {
    display: flex;
    align-items: center;
    gap: 12px;
    border-radius: var(--rounded-sm);
  }

  .enhancement-item__header[role='button'] {
    cursor: pointer;
  }

  .enhancement-item__header:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .enhancement-item__chevron {
    flex-shrink: 0;
    color: var(--color-accent);
    transition: transform 0.15s ease;
  }

  .enhancement-item__header[aria-expanded='true'] .enhancement-item__chevron {
    transform: rotate(90deg);
  }

  .enhancement-item__id {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--color-ink-secondary);
    flex-shrink: 0;
  }

  .enhancement-item__title {
    flex: 1;
    color: var(--color-ink-primary);
  }

  .enhancement-item__title--withdrawn {
    color: var(--color-ink-secondary);
  }

  .enhancement-item__badges {
    display: flex;
    gap: 4px;
    flex-shrink: 0;
  }

  .enhancement-item__no-baseline {
    font-family: var(--font-meta);
    font-size: 13px;
    color: var(--color-ink-secondary);
  }

  .enhancement-item__statement {
    margin-top: 12px;
  }
</style>

<script>
  // Delegated single script over all `.enhancement-item` instances on the
  // page, matching `BaselineFilter.astro`'s existing pattern -- Astro
  // de-duplicates identical inline/module scripts across repeated component
  // instances, so a `document.currentScript.closest()` per-instance approach
  // (see spec Design Notes) can't be relied on to run once per Enhancement.
  import { setUrlState } from '../utils/urlState';

  function currentHashSlug(): string | null {
    const hash = window.location.hash;
    if (!hash) return null;
    return hash.startsWith('#') ? hash.slice(1) : hash;
  }

  document.querySelectorAll<HTMLElement>('.enhancement-item').forEach((item) => {
    const header = item.querySelector<HTMLElement>('.enhancement-item__header');
    const body = item.querySelector<HTMLElement>('.enhancement-item__statement');
    // No statement means no toggle affordance was rendered (role/tabindex/
    // aria-expanded all omitted server-side) -- nothing to wire up.
    if (!header || !body || header.getAttribute('role') !== 'button') return;

    function reveal() {
      header!.setAttribute('aria-expanded', 'true');
      body!.hidden = false;
    }

    function toggle() {
      const expanded = header!.getAttribute('aria-expanded') === 'true';
      header!.setAttribute('aria-expanded', String(!expanded));
      body!.hidden = expanded;
      if (!expanded) setUrlState({ hash: item.id });
    }

    header.addEventListener('click', toggle);
    header.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        toggle();
      }
    });

    // Auto-expand on a matching deep-link hash without rewriting the URL
    // back to the value it already has (setUrlState() would be a no-op
    // replaceState, but there's no reason to call it).
    if (currentHashSlug() === item.id) {
      reveal();
    }
  });
</script>
