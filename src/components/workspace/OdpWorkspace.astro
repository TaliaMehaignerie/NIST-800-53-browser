    font-size: 13px;
    color: var(--color-ink-primary);
    background: var(--color-surface-overlay);
    border: none;
    border-radius: var(--rounded-sm);
    padding: 6px 14px;
    cursor: pointer;
  }

  .odp-dashboard__action:hover:not(:disabled) {
    background: var(--color-border-hairline);
  }

  .odp-dashboard__action:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }

  .odp-dashboard__action:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .odp-dashboard__message {
    margin: 8px 0 0;
    font-family: var(--font-meta);
    font-size: 13px;
    color: var(--color-ink-secondary);
  }

  .odp-workspace__batch-heading {
    margin: 0 0 4px;
    font-size: 1.1em;
    color: var(--color-ink-primary);
  }

  .odp-workspace__batch-intro {
    margin: 0;
    color: var(--color-ink-secondary);
    font-size: 0.9em;
    max-width: 70ch;
  }
</style>

<style is:global>
  .odp-row {
