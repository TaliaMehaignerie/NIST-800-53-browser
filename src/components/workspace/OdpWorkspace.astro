    padding-top: 12px;
    border-top: 1px solid var(--color-border-hairline);
  }

  .odp-proposals[hidden],
  .odp-proposals [hidden],
  .odp-proposals__confirm[hidden],
  .odp-proposals__status[hidden] {
    display: none;
  }

  .odp-proposals__heading {
    font-size: 1em;
    margin: 0 0 6px;
  }

  .odp-proposals__text {
    font-family: var(--font-meta);
    font-size: 13px;
    color: var(--color-ink-secondary);
  }

  .odp-proposals__confirm {
    border: 1px solid var(--color-accent);
    border-radius: var(--rounded-sm);
    padding: 8px 12px;
    margin: 8px 0;
    font-family: var(--font-meta);
    font-size: 13px;
  }

  .odp-proposals__status {
    font-family: var(--font-meta);
    font-size: 13px;
    padding: 4px 8px;
    border-left: 3px solid var(--color-ink-secondary);
    background: var(--color-surface-overlay);
  }
</style>

<script>
  import { getDecision, getDecisions, type Decision, type DecisionStatus } from '../../utils/odpStore';
  import {
    buildValueField,
    decisionKey,
    adoptProposals,
    fanOutDecision,
    readValue,
    saveDecision,
    setFieldValue,
    validateOverrideRationale,
    validateValue,
    type ValueFieldSelect,
    FAN_OUT_FAILED_MESSAGE,
    SAVE_FAILED_MESSAGE,
  } from '../../utils/odpEdit';
  import { controlUrl, odpDatasetUrl, odpMetaUrl, workspaceUrl } from '../../utils/url';
  import {
    groupDashOneClusters,
    computeClusterMatch,
    type Cluster,
    type OdpDatasetEntry,
  } from '../../utils/odpCluster';
  import { buildOscalProfile, downloadOscalProfile, type Baseline } from '../../utils/oscalExport';
  import { setUrlState } from '../../utils/urlState';
  import { baselineLabel, getActiveBaseline, hasChosenBaseline, isBaseline, setActiveBaseline } from '../../utils/activeBaseline';
  import { tallyStatuses, type StatusCounts } from '../../utils/odpCounts';
  import { onOdpStorageChange } from '../../utils/storageSync';
  import { proposalsFor, proposalSourceText, proposalValueText, type Proposal } from '../../utils/odpProposals';
  import { buildDiscussionToggle, discussionFromEndpoint } from '../../utils/odpContext';
  import { slugify } from '../../utils/slugify';

  // Story 6: three views (Dashboard / Batch entry / Individual parameters)
  // switched by a button group whose state lives in the URL query (AD-3),
  // written exclusively through `setUrlState`. The Individual view always
  // requires a family (no "all families" option) — this is what keeps the
  // DOM-size guarantee structural: rows are built only for the selected
  // family, never all 643 up front (spec Boundaries).
  type ViewName = 'dashboard' | 'batch' | 'individual';

  let currentView: ViewName = 'dashboard';
  let currentFamily = '';
  let unreviewedOnly = false;
  let representedFamilies: string[] = [];

  const STATUS_TEXT: Record<DecisionStatus, string> = {
    'unreviewed-default': 'Unreviewed',
    confirmed: 'Confirmed',
    overridden: 'Overridden',
  };

  // Individual rows register themselves here so a batch save (below) can
  // refresh an already-rendered row's display in place — no reload needed
  // to see the fan-out (spec manual checks).
  // `snapshot` is the JSON of the decision this row last displayed, so a
  // cross-tab `storage` event only touches rows whose stored decision actually
  // changed (never clobbering unsaved typing in an unrelated row).
  const rowRegistry = new Map<string, { row: HTMLElement; select: ValueFieldSelect; snapshot: string; proposal?: Proposal }>();
  const batchMatchRegistry: { matchLabel: HTMLElement; cluster: Cluster }[] = [];

  function snapshotOf(decision: Decision | undefined): string {
    return JSON.stringify(decision ?? null);
  }

  // Story 20: proposals for this baseline's unreviewed parameters, read across
  // the other baselines' blobs (odpProposals.ts). A proposal is never stored
  // and never changes a decision's status: it only prefills a row until the
  // user confirms or overrides it, so the readiness gate still counts it as
  // unreviewed.
  let proposals = new Map<string, Proposal>();

  function buildProposalNote(proposal: Proposal): HTMLElement {
    const note = document.createElement('p');
    note.className = 'odp-row__proposal';
    note.dataset.odpProposal = 'true';
    note.textContent =
      `Proposed from ${proposalSourceText(proposal)}: ${proposalValueText(proposal)}. ` +
      'Nothing is saved until you confirm or override it — edit it first if this baseline needs a different value.';
    return note;
  }

  function recomputeProposals(): void {
    proposals = proposalsFor(dashboardEntries.map((e) => decisionKey(e)), dashboardBaseline);
  }

  // Story 3: readiness dashboard state. `entries`/`clusters` don't change
  // after `init()` loads them — only the decisions they're read against do
  // — so they're captured once here and every dashboard refresh recomputes
  // counts fresh from `getDecision` over them (never cached, never stored;
  // spec Design Notes).
  let dashboardEntries: OdpDatasetEntry[] = [];
  let dashboardClusters: Cluster[] = [];
  let dashboardBaseline = '';

  // Story 6: on a fresh load, no individual OR batch rows exist in the DOM
  // yet (I/O matrix) — clustering itself is computed once at init (needed
  // by `jumpToNextUnreviewed` regardless of whether Batch has been opened),
  // but the 9 batch rows are only actually built the first time the Batch
  // view is activated, then kept as-is (never rebuilt per switch, unlike
  // Individual's per-family rebuild).
  let batchRowsBuilt = false;

  function ensureBatchRowsBuilt(): void {
    if (batchRowsBuilt) return;
    const batchRowsContainer = document.querySelector<HTMLElement>('[data-odp-batch-rows]');
    if (!batchRowsContainer) return;
    for (const cluster of dashboardClusters) {
      batchRowsContainer.appendChild(buildBatchRow(cluster, dashboardBaseline));
    }
    batchRowsBuilt = true;
  }

  // Story 4: OSCAL export. `oscalVersion` comes from the new build-time
  // `odp-meta.json` endpoint (AD-12) — fetched once in `init()`, never
  // hardcoded or re-derived here. Export is wired independently of the
  // dashboard/rows load path so it stays available even for a baseline with
  // zero parameters or zero decisions (spec Boundaries: never gated by the
  // readiness gate, doubles as the user's backup copy). The button starts
  // `disabled` (markup) and is only enabled once `oscalVersion` has actually
  // loaded — never clickable while it could still export an empty
  // `oscal-version` (found in review: the meta fetch is async, and the
  // button was previously enabled before or even if it failed).
  let oscalVersion = '';

  function handleExport(baseline: string): void {
    const message = document.querySelector<HTMLElement>('[data-odp-export-message]');
    try {
      const decisions = getDecisions(baseline);
      const profile = buildOscalProfile({ baseline: baseline as Baseline, decisions, oscalVersion });
      downloadOscalProfile(profile, baseline as Baseline);
      if (message) {
        const count = Object.keys(decisions).length;
        message.textContent = `Exported ${count} decision${count === 1 ? '' : 's'}.`;
      }
    } catch (err) {
      console.error('OdpWorkspace: export failed', err);
      if (message) message.textContent = 'Export failed. Please try again.';
    }
  }

  function currentStatus(entry: OdpDatasetEntry, baseline: string): DecisionStatus {
    return getDecision(baseline, decisionKey(entry))?.status ?? 'unreviewed-default';
  }

  // Counting lives in `odpCounts.ts`, shared with the control-page summary
  // and the family readiness column — never a second counter.
  function computeDashboardCounts(
    entries: OdpDatasetEntry[],
    baseline: string,
  ): { overall: StatusCounts; byFamily: Map<string, StatusCounts> } {
    const { overall, byGroup } = tallyStatuses(entries, decisionKey, (e) => e.familyCode, getDecisions(baseline));
    return { overall, byFamily: byGroup };
  }

  // First entry in document order (i.e. `entries`' own order, which is what
  // rows are built from) whose current status is `unreviewed-default`.
  function findNextUnreviewedEntry(entries: OdpDatasetEntry[], baseline: string): OdpDatasetEntry | undefined {
    return entries.find((entry) => currentStatus(entry, baseline) === 'unreviewed-default');
  }

  function findClusterForEntry(entry: OdpDatasetEntry, clusters: Cluster[]): Cluster | undefined {
    return clusters.find((cluster) =>
      cluster.members.some((m) => m.controlSlug === entry.controlSlug && m.paramId === entry.paramId),
    );
  }

  // Derived from this baseline's loaded entries only — never a hardcoded or
  // corpus-wide family list (spec Boundaries).
  function getRepresentedFamilies(entries: OdpDatasetEntry[]): string[] {
    return Array.from(new Set(entries.map((entry) => entry.familyCode))).sort();
  }

  // Shows/hides the three containers and syncs the switcher's `aria-selected`
  // state — the sole place view visibility is decided. Dashboard/Batch keep
  // their exact existing rendering (built once); only their visibility
  // changes here.
  function setActiveView(view: ViewName): void {
    currentView = view;

    const dashboard = document.querySelector<HTMLElement>('[data-odp-dashboard]');
    const batch = document.querySelector<HTMLElement>('[data-odp-batch]');
    const rows = document.querySelector<HTMLElement>('[data-odp-rows]');
    const individualControls = document.querySelector<HTMLElement>('[data-odp-individual-controls]');

    if (dashboard) dashboard.hidden = view !== 'dashboard';
    // Batch only has something to show when this baseline actually has
    // dash-one clusters — every one of the 4 real baselines does today, but
    // this guard (restored from the pre-story-6 behavior, found missing in
    // review) keeps an empty section from appearing if that ever changes.
    if (batch) batch.hidden = view !== 'batch' || dashboardClusters.length === 0;
    if (rows) rows.hidden = view !== 'individual';
    if (individualControls) individualControls.hidden = view !== 'individual';

    if (view === 'batch') ensureBatchRowsBuilt();

    document.querySelectorAll<HTMLButtonElement>('[data-odp-view-btn]').forEach((btn) => {
      btn.setAttribute('aria-selected', String(btn.dataset.odpViewBtn === view));
    });
  }

  // Clears `rowRegistry` and the rows container, then builds rows only for
  // entries matching `familyCode === family` (and unreviewed-only when the
  // toggle is on) — only one family's rows ever exist in the DOM at a time
  // (spec Boundaries).
  function renderIndividualRows(family: string, unreviewedOnlyFlag: boolean): void {
    const rowsContainer = document.querySelector<HTMLElement>('[data-odp-rows]');
    if (!rowsContainer || !family) return;

    rowRegistry.clear();
    rowsContainer.innerHTML = '';

    const matching = dashboardEntries.filter(
      (entry) =>
        entry.familyCode === family &&
        (!unreviewedOnlyFlag || currentStatus(entry, dashboardBaseline) === 'unreviewed-default'),
    );

    for (const entry of matching) {
      rowsContainer.appendChild(buildRow(entry, dashboardBaseline));
    }
  }

  // Removes just the one row that changed, rather than rebuilding the whole
  // family list — this is what makes a just-confirmed/overridden row
  // disappear from view without a reload (spec Acceptance Criteria), without
  // touching storage. A full `renderIndividualRows()` rebuild here would
  // wipe every other currently-rendered row too, discarding any unsaved
  // rationale text a user had typed into a sibling row (found in review) —
  // removing only the acted-on row avoids that entirely.
  function removeRowFromIndividualViewIfFiltered(key: string): void {
    if (currentView !== 'individual' || !unreviewedOnly) return;
    const registered = rowRegistry.get(key);
    if (!registered) return;
    registered.row.remove();
    rowRegistry.delete(key);
  }

  // Switches the active view and, for `individual`, the selected family —
  // always through `setUrlState` (never a second URL-writing path), always
  // a `replaceState` write. Falls back to the first represented family
  // (alphabetical) when no valid family is given, since the Individual view
  // never has an "all families" state.
  function switchToView(view: ViewName, familyOverride?: string): void {
    if (view === 'individual') {
      const requested = familyOverride ?? currentFamily;
      const family = representedFamilies.includes(requested) ? requested : representedFamilies[0];
      if (!family) return;

      // Re-selecting the same family while already on the Individual view is
      // a no-op — skip the rebuild so it doesn't blow away scroll position
      // or in-progress input for zero actual change (found in review).
      if (currentView === 'individual' && family === currentFamily) return;
      currentFamily = family;

      const familySelect = document.querySelector<HTMLSelectElement>('[data-odp-family-select]');
      if (familySelect) familySelect.value = currentFamily;

      setActiveView('individual');
      setUrlState({
        search: { view: 'individual', family: currentFamily, unreviewed: unreviewedOnly ? '1' : null },
      });
      renderIndividualRows(currentFamily, unreviewedOnly);
    } else {
      if (currentView === view) return;
      setActiveView(view);
      setUrlState({ search: { view, family: null, unreviewed: null } });
    }
  }

  // Scrolls to and focuses the jump target: the cluster's batch row if the
  // next unreviewed entry belongs to one (`groupDashOneClusters`, story 2,
  // reused unmodified — never reimplemented here), else the entry's own row
  // in the Individual view. The view (and, for a non-clustered target, the
  // family) is switched first so the target actually exists in the DOM
  // before `scrollIntoView` runs (spec Boundaries).
  function jumpToNextUnreviewed(): void {
    const next = findNextUnreviewedEntry(dashboardEntries, dashboardBaseline);
    if (!next) return;

    const cluster = findClusterForEntry(next, dashboardClusters);
    if (cluster) {
      switchToView('batch');
    } else {
      switchToView('individual', next.familyCode);
    }

    const selector = cluster
      ? `[data-odp-cluster-key="${cluster.clusterKey}"]`
      : `[data-odp-key="${decisionKey(next)}"]`;
    const target = document.querySelector<HTMLElement>(selector);
    if (!target) return;

    target.scrollIntoView({ behavior: 'smooth', block: 'center' });
    if (!target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');
    target.focus();
  }

  function handleMarkReady(): void {
    const message = document.querySelector<HTMLElement>('[data-odp-dashboard-message]');
    const { overall } = computeDashboardCounts(dashboardEntries, dashboardBaseline);
    if (!message) return;

    if (overall.unreviewed > 0) {
      message.textContent = `Not ready — ${overall.unreviewed} parameter${overall.unreviewed === 1 ? '' : 's'} still unreviewed.`;
      return;
    }

    message.textContent = `Ready — all ${overall.total} parameters reviewed.`;
  }

  function renderProposals(unreviewed: number): void {
    const block = document.querySelector<HTMLElement>('[data-odp-proposals]');
    if (!block) return;
    const status = block.querySelector<HTMLElement>('[data-odp-adopt-status]')!;
    const live = proposals.size > 0;
    // With nothing left to propose only the result message may remain; the
    // heading, text and adopt button would otherwise describe a stale list.
    block.hidden = !live && status.hidden;
    block.querySelector<HTMLElement>('.odp-proposals__heading')!.hidden = !live;
    block.querySelector<HTMLElement>('[data-odp-proposals-text]')!.hidden = !live;
    block.querySelector<HTMLElement>('[data-odp-adopt-all]')!.parentElement!.hidden = !live;
    if (!live) {
      block.querySelector<HTMLElement>('[data-odp-adopt-confirm]')!.hidden = true;
      return;
    }

    const bySource = new Map<string, number>();
    for (const p of proposals.values()) bySource.set(p.from, (bySource.get(p.from) ?? 0) + 1);
    const breakdown = Array.from(bySource, ([from, n]) => `${n} from ${baselineLabel(from)}`).join(', ');
    const n = proposals.size;
    block.querySelector<HTMLElement>('[data-odp-proposals-text]')!.textContent =
      `${n} unreviewed parameter${n === 1 ? ' already has' : 's already have'} a decision in another baseline (${breakdown}). ` +
      'These are proposals only: nothing is saved until you confirm each one, or adopt them together below. ' +
      `${unreviewed - n} ha${unreviewed - n === 1 ? 's' : 've'} no decision anywhere yet.`;
  }

  // Recomputes and re-renders the whole dashboard from current decision
  // state — called on load and after every successful individual/batch save
  // so the dashboard is never stale relative to the decisions it counts
  // (spec Tasks & Acceptance).
  function refreshDashboard(): void {
    window.dispatchEvent(new CustomEvent('odpdecisionschanged'));
    const dashboard = document.querySelector<HTMLElement>('[data-odp-dashboard]');
    if (!dashboard || dashboardEntries.length === 0) return;
    // Visibility is owned by `setActiveView`, not this function — the
    // dashboard is recomputed on every decision change regardless of which
    // view is currently active, so it's never stale the moment it's shown.

    const { overall, byFamily } = computeDashboardCounts(dashboardEntries, dashboardBaseline);
    renderProposals(overall.unreviewed);

    const summary = dashboard.querySelector<HTMLElement>('[data-odp-dashboard-summary]');
    if (summary) {
      const pct = (n: number) => (overall.total > 0 ? Math.round((n / overall.total) * 100) : 0);
      summary.textContent =
        `${overall.unreviewed} unreviewed (${pct(overall.unreviewed)}%) / ` +
        `${overall.confirmed} confirmed (${pct(overall.confirmed)}%) / ` +
        `${overall.overridden} overridden (${pct(overall.overridden)}%) of ${overall.total} total`;
    }

    const tbody = dashboard.querySelector<HTMLElement>('[data-odp-dashboard-tbody]');
    if (tbody) {
      tbody.innerHTML = '';
      const families = Array.from(byFamily.keys()).sort();
      for (const family of families) {
        const counts = byFamily.get(family);
        if (!counts) continue;
        const tr = document.createElement('tr');
        const values = [
          family.toUpperCase(),
          String(counts.unreviewed),
          String(counts.confirmed),
          String(counts.overridden),
          String(counts.total),
        ];
        for (const text of values) {
          const td = document.createElement('td');
          td.textContent = text;
          tr.appendChild(td);
        }
        tbody.appendChild(tr);
      }
    }

    const jumpBtn = dashboard.querySelector<HTMLButtonElement>('[data-odp-jump-next]');
    if (jumpBtn) {
      jumpBtn.disabled = !findNextUnreviewedEntry(dashboardEntries, dashboardBaseline);
    }

    const markReadyBtn = dashboard.querySelector<HTMLButtonElement>('[data-odp-mark-ready]');
    const message = dashboard.querySelector<HTMLElement>('[data-odp-dashboard-message]');
    if (markReadyBtn) {
      markReadyBtn.disabled = overall.unreviewed > 0;
    }
    if (message) {
      message.textContent =
        overall.unreviewed > 0
          ? `Not ready — ${overall.unreviewed} parameter${overall.unreviewed === 1 ? '' : 's'} still unreviewed.`
          : '';
    }
  }

  function buildRow(entry: OdpDatasetEntry, baseline: string): HTMLElement {
    const key = decisionKey(entry);
    const existing = getDecision(baseline, key);
    const proposal = existing ? undefined : proposals.get(key);

    const row = document.createElement('article');
    row.className = 'odp-row';
    row.dataset.odpKey = key;

    const header = document.createElement('header');
    header.className = 'odp-row__header';

    const controlSpan = document.createElement('span');
    controlSpan.className = 'odp-row__control-id';
    // Enhancements have no route of their own (AD-4): link to the parent
    // control page, at the enhancement's own fragment.
    const controlLink = document.createElement('a');
    controlLink.href = entry.controlId.includes('.')
      ? `${controlUrl(slugify(entry.controlId.split('.')[0]))}#${entry.controlSlug}`
      : controlUrl(entry.controlSlug);
    controlLink.textContent = `${entry.controlId.toUpperCase()} — ${entry.controlTitle}`;
    controlSpan.appendChild(controlLink);
    header.appendChild(controlSpan);

    const paramSpan = document.createElement('span');
    paramSpan.className = 'odp-row__param-id';
    paramSpan.textContent = entry.paramId;
    header.appendChild(paramSpan);

    const statusLabel = document.createElement('span');
    statusLabel.className = 'odp-row__status-label';
    statusLabel.dataset.odpStatusLabel = 'true';
    header.appendChild(statusLabel);

    row.appendChild(header);

    // The statement sentence this param sits in, resolved at build time
    // (spec Boundaries) — omitted entirely when null, never an empty block
    // (399 of 1600 real params have no statement reference at all).
    if (entry.statementProse) {
      const proseP = document.createElement('p');
      proseP.className = 'odp-row__statement';
      proseP.textContent = entry.statementProse;
      row.appendChild(proseP);
    }

    if (entry.label) {
      const labelP = document.createElement('p');
      labelP.className = 'odp-row__label';
      labelP.textContent = entry.label;
      row.appendChild(labelP);
    }

    if (entry.guidelines.length > 0) {
      const list = document.createElement('ul');
      list.className = 'odp-row__guidelines';
      for (const g of entry.guidelines) {
        const li = document.createElement('li');
        li.textContent = g;
        list.appendChild(li);
      }
      row.appendChild(list);
    }

    row.appendChild(
      buildDiscussionToggle(entry.controlId.toUpperCase(), `odp-${entry.controlSlug}-${entry.paramId}`.replace(/[^a-zA-Z0-9_-]/g, '-'), () =>
        discussionFromEndpoint(entry.controlSlug),
      ),
    );

    if (proposal) row.appendChild(buildProposalNote(proposal));

    const fieldId = `odp-value-${entry.controlSlug}-${entry.paramId}`;
    row.appendChild(buildValueField(fieldId, entry.select, existing?.value ?? proposal?.value));

    const rationaleField = document.createElement('div');
    rationaleField.className = 'odp-row__field';
    const rationaleLabel = document.createElement('label');
    const rationaleId = `odp-rationale-${entry.controlSlug}-${entry.paramId}`;
    rationaleLabel.setAttribute('for', rationaleId);
    rationaleLabel.textContent = 'Rationale (required to override)';
    rationaleField.appendChild(rationaleLabel);
    const rationaleInput = document.createElement('textarea');
    rationaleInput.className = 'odp-row__rationale-input';
    rationaleInput.id = rationaleId;
    rationaleInput.dataset.odpRationaleInput = 'true';
    rationaleInput.rows = 2;
    rationaleInput.value = existing?.rationale ?? proposal?.rationale ?? '';
    rationaleField.appendChild(rationaleInput);
    row.appendChild(rationaleField);

    const errorP = document.createElement('p');
    errorP.className = 'odp-row__error';
    errorP.setAttribute('role', 'alert');
    errorP.hidden = true;
    errorP.dataset.odpError = 'true';
    row.appendChild(errorP);

    const actions = document.createElement('div');
    actions.className = 'odp-row__actions';
    actions.setAttribute('role', 'group');
    actions.setAttribute('aria-label', `${entry.controlId.toUpperCase()} ${entry.paramId} decision status`);

    const confirmBtn = document.createElement('button');
    confirmBtn.type = 'button';
    confirmBtn.className = 'odp-row__action';
    confirmBtn.dataset.odpAction = 'confirmed';
    confirmBtn.textContent = 'Confirm';
    confirmBtn.setAttribute('aria-pressed', 'false');
    actions.appendChild(confirmBtn);

    const overrideBtn = document.createElement('button');
    overrideBtn.type = 'button';
    overrideBtn.className = 'odp-row__action';
    overrideBtn.dataset.odpAction = 'overridden';
    overrideBtn.textContent = 'Override';
    overrideBtn.setAttribute('aria-pressed', 'false');
    actions.appendChild(overrideBtn);

    row.appendChild(actions);

    applyStatus(row, existing?.status ?? 'unreviewed-default');

    function handleAction(status: DecisionStatus) {
      const error = row.querySelector('[data-odp-error]') as HTMLElement;
      error.hidden = true;
      error.textContent = '';

      const value = readValue(entry.select, row);
      const rationale = (row.querySelector('[data-odp-rationale-input]') as HTMLTextAreaElement).value;

      const validationError = validateValue(value) ?? validateOverrideRationale(status, rationale);
      if (validationError) {
        error.textContent = validationError;
        error.hidden = false;
        return;
      }

      const decision: Decision = { value, status, rationale };
      const ok = saveDecision(baseline, key, decision);
      if (!ok) {
        error.textContent = SAVE_FAILED_MESSAGE;
        error.hidden = false;
        return;
      }

      applyStatus(row, status);
      row.querySelector('[data-odp-proposal]')?.remove();
      proposals.delete(key);
      const registeredRow = rowRegistry.get(key);
      if (registeredRow) {
        registeredRow.snapshot = snapshotOf(decision);
        registeredRow.proposal = undefined;
      }
      refreshDashboard();
      removeRowFromIndividualViewIfFiltered(key);
    }

    confirmBtn.addEventListener('click', () => handleAction('confirmed'));
    overrideBtn.addEventListener('click', () => handleAction('overridden'));

    rowRegistry.set(key, { row, select: entry.select, snapshot: snapshotOf(existing), proposal });

    return row;
  }

  // Story 12: passive cross-tab refresh. Updates only rows whose stored
  // decision differs from what they last showed, then the batch match labels.
  // Rows with no stored decision show a proposal; if a source baseline changed
  // (another tab, an adopt), update the note so nobody confirms an outdated
  // answer. The prefill follows only while the user has not edited it.
  function refreshProposalRows(): void {
    for (const [key, registered] of rowRegistry) {
      if (registered.snapshot !== snapshotOf(undefined)) continue;
      const next = proposals.get(key);
      if (JSON.stringify(next ?? null) === JSON.stringify(registered.proposal ?? null)) continue;

      const prev = registered.proposal;
      const valueNow = readValue(registered.select, registered.row);
      const rationaleEl = registered.row.querySelector('[data-odp-rationale-input]') as HTMLTextAreaElement | null;
      const emptyValue = registered.select?.howMany === 'one-or-more' ? [] : '';
      const unedited =
        JSON.stringify(valueNow) === JSON.stringify(prev?.value ?? emptyValue) &&
        (rationaleEl?.value ?? '') === (prev?.rationale ?? '');

      registered.row.querySelector('[data-odp-proposal]')?.remove();
      if (next) {
        const anchor = registered.row.querySelector('.odp-row__field');
        registered.row.insertBefore(buildProposalNote(next), anchor);
      }
      if (unedited) {
        setFieldValue(registered.select, registered.row, next?.value ?? emptyValue);
        if (rationaleEl) rationaleEl.value = next?.rationale ?? '';
      }
      registered.proposal = next;
    }
  }

  function refreshFromStorage(): void {
    recomputeProposals();
    const decisions = getDecisions(dashboardBaseline);
    for (const [key, registered] of Array.from(rowRegistry.entries())) {
      const decision = decisions[key];
      if (snapshotOf(decision) === registered.snapshot) continue;
      // A decision that vanished (blob cleared in another tab) resets the row
      // to unreviewed so it agrees with the recounted dashboard.
      setFieldValue(registered.select, registered.row, decision?.value ?? (registered.select?.howMany === 'one-or-more' ? [] : ''));
      const rationaleInput = registered.row.querySelector('[data-odp-rationale-input]') as HTMLTextAreaElement | null;
      if (rationaleInput) rationaleInput.value = decision?.rationale ?? '';
      applyStatus(registered.row, decision?.status ?? 'unreviewed-default');
      registered.snapshot = snapshotOf(decision);
      if (decision) {
        registered.row.querySelector('[data-odp-proposal]')?.remove();
        removeRowFromIndividualViewIfFiltered(key);
      }
    }
    for (const { matchLabel, cluster } of batchMatchRegistry) {
      refreshClusterMatch(matchLabel, cluster, dashboardBaseline);
    }
    refreshProposalRows();
    refreshDashboard();
  }

  function applyStatus(row: HTMLElement, status: DecisionStatus) {
    const statusLabel = row.querySelector('[data-odp-status-label]') as HTMLElement;
    statusLabel.textContent = STATUS_TEXT[status];
    statusLabel.dataset.status = status;

    row.querySelectorAll<HTMLButtonElement>('[data-odp-action]').forEach((btn) => {
      btn.setAttribute('aria-pressed', String(btn.dataset.odpAction === status));
    });
  }

  function refreshClusterMatch(matchLabel: HTMLElement, cluster: Cluster, baseline: string): void {
    const currentValues = cluster.members.map((m) => getDecision(baseline, `${m.controlSlug}:${m.paramId}`)?.value);
    const { matchCount, total } = computeClusterMatch(currentValues);
    matchLabel.textContent = `${matchCount}/${total} controls match this value`;
  }

  // The batch row: one per dash-one cluster (spec Tasks & Acceptance). Reuses
  // `buildValueField`/`readValue` for the same free-text/select input as an
  // individual row, and loops `setDecision` once per member — never a
  // combined or batch-tagged storage entry (AD-11). Reuses `setDecision`'s
  // own override-requires-rationale rejection rather than reimplementing
  // that check here.
  function buildBatchRow(cluster: Cluster, baseline: string): HTMLElement {
    const currentValues = cluster.members.map((m) => getDecision(baseline, `${m.controlSlug}:${m.paramId}`)?.value);
    const { majorityValue } = computeClusterMatch(currentValues);

    const row = document.createElement('article');
    row.className = 'odp-row odp-row--batch';
    row.dataset.odpClusterKey = cluster.clusterKey;

    const header = document.createElement('header');
    header.className = 'odp-row__header';

    const paramSpan = document.createElement('span');
    paramSpan.className = 'odp-row__param-id';
    paramSpan.textContent = cluster.clusterKey;
    header.appendChild(paramSpan);

    // Collapsed-by-default list of covered control ids (spec Tasks &
    // Acceptance) — the count itself is the disclosure trigger, following
    // the same role/aria-expanded pattern as EnhancementItem.astro.
    const memberIds = cluster.members.map((m) => m.controlId.toUpperCase());
    const memberListId = `odp-batch-members-${cluster.clusterKey}`;
    const countToggle = document.createElement('span');
    countToggle.className = 'odp-row__param-id odp-row__member-toggle';
    countToggle.textContent = `${cluster.members.length} dash-one controls`;
    countToggle.setAttribute('role', 'button');
    countToggle.setAttribute('tabindex', '0');
    countToggle.setAttribute('aria-expanded', 'false');
    countToggle.setAttribute('aria-controls', memberListId);
    header.appendChild(countToggle);

    const matchLabel = document.createElement('span');
    matchLabel.className = 'odp-row__match-label';
    matchLabel.dataset.odpBatchMatch = 'true';
    header.appendChild(matchLabel);

    row.appendChild(header);

    const memberList = document.createElement('p');
    memberList.id = memberListId;
    memberList.className = 'odp-row__member-list';
    memberList.textContent = memberIds.join(', ');
    memberList.hidden = true;
    row.appendChild(memberList);

    function toggleMemberList() {
      const expanded = countToggle.getAttribute('aria-expanded') === 'true';
      countToggle.setAttribute('aria-expanded', String(!expanded));
      memberList.hidden = expanded;
    }
    countToggle.addEventListener('click', toggleMemberList);
    countToggle.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        toggleMemberList();
      }
    });

    // Shared title/sentence only when identical across every member (spec
    // Boundaries) — a divergent cluster (e.g. `odp.03`'s 18 distinct
    // sentences) shows one member's sentence explicitly attributed to that
    // control, never presented as if it applied to all.
    if (cluster.sharedTitle) {
      const titleP = document.createElement('p');
      titleP.className = 'odp-row__shared-title';
      titleP.textContent = cluster.sharedTitle;
      row.appendChild(titleP);
    }

    if (cluster.sharedProse) {
      const proseP = document.createElement('p');
      proseP.className = 'odp-row__statement';
      proseP.textContent = cluster.sharedProse;
      row.appendChild(proseP);
    } else if (cluster.representative.statementProse) {
      const proseP = document.createElement('p');
      proseP.className = 'odp-row__statement';
      proseP.textContent = `${cluster.representative.statementProse} (shown for ${cluster.representative.controlId.toUpperCase()}; wording varies by control in this cluster)`;
      row.appendChild(proseP);
    }

    if (cluster.label) {
      const labelP = document.createElement('p');
      labelP.className = 'odp-row__label';
      labelP.textContent = cluster.label;
      row.appendChild(labelP);
    }

    if (cluster.guidelines.length > 0) {
      const list = document.createElement('ul');
      list.className = 'odp-row__guidelines';
      for (const g of cluster.guidelines) {
        const li = document.createElement('li');
        li.textContent = g;
        list.appendChild(li);
      }
      row.appendChild(list);
    }

    // Dash-one controls share one purpose (each family's policy and procedures),
    // so the first member's discussion is shown, attributed to that control.
    const discussionSource = cluster.members[0];
    if (discussionSource) {
      row.appendChild(
        buildDiscussionToggle(
          discussionSource.controlId.toUpperCase(),
          `odp-batch-${cluster.clusterKey}`.replace(/[^a-zA-Z0-9_-]/g, '-'),
          () => discussionFromEndpoint(discussionSource.controlSlug),
        ),
      );
    }

    const fieldId = `odp-batch-value-${cluster.clusterKey}`;
    row.appendChild(buildValueField(fieldId, cluster.select, majorityValue));

    const rationaleField = document.createElement('div');
    rationaleField.className = 'odp-row__field';
    const rationaleLabel = document.createElement('label');
    const rationaleId = `odp-batch-rationale-${cluster.clusterKey}`;
    rationaleLabel.setAttribute('for', rationaleId);
    rationaleLabel.textContent = 'Rationale (required to override)';
    rationaleField.appendChild(rationaleLabel);
    const rationaleInput = document.createElement('textarea');
    rationaleInput.className = 'odp-row__rationale-input';
    rationaleInput.id = rationaleId;
    rationaleInput.dataset.odpRationaleInput = 'true';
    rationaleInput.rows = 2;
    rationaleField.appendChild(rationaleInput);
    row.appendChild(rationaleField);

    const errorP = document.createElement('p');
    errorP.className = 'odp-row__error';
    errorP.setAttribute('role', 'alert');
    errorP.hidden = true;
    errorP.dataset.odpError = 'true';
    row.appendChild(errorP);

    const actions = document.createElement('div');
    actions.className = 'odp-row__actions';
    actions.setAttribute('role', 'group');
    actions.setAttribute('aria-label', `${cluster.clusterKey} batch decision`);

    const confirmBtn = document.createElement('button');
    confirmBtn.type = 'button';
    confirmBtn.className = 'odp-row__action';
    confirmBtn.dataset.odpAction = 'confirmed';
    confirmBtn.textContent = 'Confirm';
    actions.appendChild(confirmBtn);

    const overrideBtn = document.createElement('button');
    overrideBtn.type = 'button';
    overrideBtn.className = 'odp-row__action';
    overrideBtn.dataset.odpAction = 'overridden';
    overrideBtn.textContent = 'Override';
    actions.appendChild(overrideBtn);

    row.appendChild(actions);

    refreshClusterMatch(matchLabel, cluster, baseline);
    batchMatchRegistry.push({ matchLabel, cluster });

    function handleBatchAction(status: DecisionStatus) {
      const error = row.querySelector('[data-odp-error]') as HTMLElement;
      error.hidden = true;
      error.textContent = '';

      const value = readValue(cluster.select, row);
      const rationale = (row.querySelector('[data-odp-rationale-input]') as HTMLTextAreaElement).value;

      const validationError = validateValue(value);
      if (validationError) {
        error.textContent = validationError;
        error.hidden = false;
        return;
      }

      const decision: Decision = { value, status, rationale };

      // One independent `setDecision` call per member (AD-11) — never a
      // combined write. `setDecision`'s own rationale-required rejection is
      // reused unmodified, and since `decision` is identical for every
      // member, that specific rejection does fire for every call together
      // (checked before any storage write). A *storage-layer* failure
      // (`localStorage.setItem` throwing — quota exceeded, private mode) is
      // not guaranteed atomic the same way: it can happen partway through
      // the loop, after earlier members already wrote successfully. So on
      // any failure, still resync the display for whichever members did
      // succeed — never leave a row showing a stale value/status for a
      // decision that's actually already been persisted.
      const results = fanOutDecision(baseline, cluster.members, decision);

      for (const { member, ok } of results) {
        if (!ok) continue;
        const key = decisionKey(member);
        const registered = rowRegistry.get(key);
        if (!registered) continue;
        setFieldValue(registered.select, registered.row, value);
        const memberRationaleInput = registered.row.querySelector(
          '[data-odp-rationale-input]',
        ) as HTMLTextAreaElement | null;
        if (memberRationaleInput) memberRationaleInput.value = rationale;
        applyStatus(registered.row, status);
        registered.snapshot = snapshotOf(decision);
        registered.proposal = undefined;
        proposals.delete(key);
        // Remove just this member's row if it's now filtered out, rather
        // than rebuilding the whole family list (which would also discard
        // any unsaved input in an unrelated sibling row still awaiting
        // review — found in review).
        removeRowFromIndividualViewIfFiltered(key);
      }

      if (!results.every((r) => r.ok)) {
        error.textContent = FAN_OUT_FAILED_MESSAGE;
        error.hidden = false;
      }

      refreshClusterMatch(matchLabel, cluster, baseline);
      // At least one member write may have succeeded even when `results`
      // includes a failure (see comment above) — refresh regardless so the
      // dashboard never undercounts a decision that's actually persisted.
      refreshDashboard();
    }

    confirmBtn.addEventListener('click', () => handleBatchAction('confirmed'));
    overrideBtn.addEventListener('click', () => handleBatchAction('overridden'));

    return row;
  }

  async function init() {
    const workspace = document.querySelector<HTMLElement>('[data-odp-workspace]');
    if (!workspace) return;
    const baselineValue = workspace.dataset.baseline;
    if (!baselineValue) return;
    // The route's baseline is authoritative for this page, but opening it never
    // changes your system's baseline (that is set once, on Review, and changed
    // only on Your data). Say so plainly when they differ.
    // Only when none has been chosen yet: opening a table is then unambiguous
    // intent, and decisions made here must show up everywhere else.
    if (!hasChosenBaseline() && isBaseline(baselineValue)) setActiveBaseline(baselineValue);
    const baselineNote = workspace.querySelector<HTMLElement>('[data-odp-baseline-note]');
    if (baselineNote && hasChosenBaseline() && getActiveBaseline() !== baselineValue) {
      const chosen = getActiveBaseline();
      baselineNote.textContent = `This is the ${baselineLabel(baselineValue)} table. Your system's baseline is ${baselineLabel(chosen)}: `;
      const link = document.createElement('a');
      link.href = workspaceUrl(chosen);
      link.textContent = `go to the ${baselineLabel(chosen)} parameters`;
      baselineNote.append(link, document.createTextNode('.'));
      baselineNote.hidden = false;
    }

    const loading = workspace.querySelector<HTMLElement>('[data-odp-loading]');
    const empty = workspace.querySelector<HTMLElement>('[data-odp-empty]');
    const rowsContainer = workspace.querySelector<HTMLElement>('[data-odp-rows]');
    if (!rowsContainer) return;

    // The export button's click listener is wired up-front, before the
    // dataset fetch below, so it stays usable even if that fetch fails —
    // export only depends on `odp-meta.json` and whatever decisions already
    // exist in storage (spec Boundaries: always available, including with
    // zero decisions). The button itself starts `disabled` (markup) and is
    // only enabled once `oscalVersion` has actually loaded, below — clicking
    // it can never produce a document with an empty `oscal-version`.
    const exportBtn = workspace.querySelector<HTMLButtonElement>('[data-odp-export]');
    const exportMessage = workspace.querySelector<HTMLElement>('[data-odp-export-message]');
    exportBtn?.addEventListener('click', () => handleExport(baselineValue));

    try {
      const metaResponse = await fetch(odpMetaUrl());
      if (!metaResponse.ok) throw new Error(`odp-meta.json fetch failed: ${metaResponse.status}`);
      const meta = (await metaResponse.json()) as { oscalVersion: string };
      if (!meta.oscalVersion) throw new Error('odp-meta.json returned an empty oscalVersion');
      oscalVersion = meta.oscalVersion;
      if (exportBtn) exportBtn.disabled = false;
      if (exportMessage) exportMessage.textContent = '';
    } catch (err) {
      console.error('OdpWorkspace: failed to load odp-meta.json', err);
      if (exportMessage) exportMessage.textContent = 'Export is unavailable — could not load export metadata. Please reload the page.';
    }

    let dataset: OdpDatasetEntry[];
    try {
      const response = await fetch(odpDatasetUrl());
      if (!response.ok) throw new Error(`odp-dataset.json fetch failed: ${response.status}`);
      dataset = await response.json();
    } catch (err) {
      console.error('OdpWorkspace: failed to load odp-dataset.json', err);
      if (loading) loading.hidden = true;
      if (empty) {
        empty.hidden = false;
        empty.textContent = 'Unable to load parameters. Please reload the page.';
      }
      return;
    }

    const entries = dataset.filter((entry) => entry.baselines.includes(baselineValue as OdpDatasetEntry['baselines'][number]));

    if (loading) loading.hidden = true;

    if (entries.length === 0) {
      if (empty) empty.hidden = false;
      return;
    }

    // Clustering is computed at render time only, from this baseline's
    // entries — never stored (AD-11). The batch rows themselves are built
    // lazily, the first time the Batch view is activated (`ensureBatchRowsBuilt`),
    // so a fresh load builds neither Individual nor Batch rows up front.
    const clusters = groupDashOneClusters(entries);

    dashboardEntries = entries;
    dashboardClusters = clusters;
    dashboardBaseline = baselineValue;
    recomputeProposals();

    // Individual rows are no longer built for every entry up front (story 6)
    // — only the represented families are computed here; rows for whichever
    // family ends up selected are built by `renderIndividualRows` below.
    representedFamilies = getRepresentedFamilies(entries);
    const familySelect = workspace.querySelector<HTMLSelectElement>('[data-odp-family-select]');
    if (familySelect) {
      familySelect.innerHTML = '';
      for (const family of representedFamilies) {
        const option = document.createElement('option');
        option.value = family;
        option.textContent = family.toUpperCase();
        familySelect.appendChild(option);
      }
      familySelect.addEventListener('change', () => {
        switchToView('individual', familySelect.value);
      });
    }

    const unreviewedToggle = workspace.querySelector<HTMLInputElement>('[data-odp-unreviewed-toggle]');
    unreviewedToggle?.addEventListener('change', () => {
      unreviewedOnly = unreviewedToggle.checked;
      setUrlState({
        search: { view: 'individual', family: currentFamily, unreviewed: unreviewedOnly ? '1' : null },
      });
      renderIndividualRows(currentFamily, unreviewedOnly);
    });

    workspace.querySelectorAll<HTMLButtonElement>('[data-odp-view-btn]').forEach((btn) => {
      const view = btn.dataset.odpViewBtn as ViewName;
      btn.addEventListener('click', () => switchToView(view));
    });

    const jumpBtn = workspace.querySelector<HTMLButtonElement>('[data-odp-jump-next]');
    jumpBtn?.addEventListener('click', () => jumpToNextUnreviewed());

    const markReadyBtn = workspace.querySelector<HTMLButtonElement>('[data-odp-mark-ready]');
    markReadyBtn?.addEventListener('click', () => handleMarkReady());

    // Initial view/family/unreviewed-only state comes from the URL
    // (`?view=`/`?family=`/`?unreviewed=`), defaulting per Boundaries: an
    // absent or invalid `view` defaults to `dashboard`; an absent or invalid
    // `family` (not one of `representedFamilies`) defaults to the first
    // represented family alphabetically — never a hardcoded/corpus-wide one.
    const params = new URLSearchParams(window.location.search);
    const rawView = params.get('view');
    const initialView: ViewName = rawView === 'batch' || rawView === 'individual' ? rawView : 'dashboard';
    const rawFamily = params.get('family');
    unreviewedOnly = params.get('unreviewed') === '1';
    if (unreviewedToggle) unreviewedToggle.checked = unreviewedOnly;

    const viewSwitcher = workspace.querySelector<HTMLElement>('[data-odp-view-switcher]');
    if (viewSwitcher) viewSwitcher.hidden = false;

    // No dash-one clusters for this baseline means nothing to batch — hide
    // the tab itself rather than leaving a dead button that opens an empty
    // section (matches the pre-story-6 behavior; every real baseline today
    // has 9 clusters, but this keeps the guarantee explicit).
    const batchTab = workspace.querySelector<HTMLButtonElement>('[data-odp-view-btn="batch"]');
    if (batchTab && dashboardClusters.length === 0) batchTab.hidden = true;

    if (initialView === 'individual') {
      switchToView('individual', rawFamily ?? undefined);
    } else {
      setActiveView(initialView);
    }

    refreshDashboard();

    // Proposals read the OTHER baselines' blobs, so any decision blob changing
    // (not just this baseline's) refreshes them.
    onOdpStorageChange(refreshFromStorage, { baseline: false });

    // Bulk adopt: a proposal still costs an act of review, so this is previewed
    // with provenance and confirmed, and re-checked against the data as it is
    // at confirm time. Each decision is recorded under its source's status and
    // rationale, independent and individually editable afterward.
    const adoptBlock = workspace.querySelector<HTMLElement>('[data-odp-proposals]');
    if (adoptBlock) {
      const confirmEl = adoptBlock.querySelector<HTMLElement>('[data-odp-adopt-confirm]')!;
      const statusEl = adoptBlock.querySelector<HTMLElement>('[data-odp-adopt-status]')!;
      let planned = new Map<string, Proposal>();

      const signature = (m: Map<string, Proposal>) =>
        JSON.stringify(Array.from(m, ([k, p]) => [k, p.from, p.status, p.value, p.rationale]).sort());
      const sayAdopt = (text: string) => {
        statusEl.textContent = text;
        statusEl.hidden = false;
      };
      const closeAdopt = () => {
        planned = new Map();
        confirmEl.hidden = true;
      };

      adoptBlock.querySelector('[data-odp-adopt-all]')!.addEventListener('click', () => {
        statusEl.hidden = true;
        planned = new Map(proposals);
        const bySource = new Map<string, { confirmed: number; overridden: number }>();
        for (const p of planned.values()) {
          const c = bySource.get(p.from) ?? { confirmed: 0, overridden: 0 };
          c[p.status] += 1;
          bySource.set(p.from, c);
        }
        const parts = Array.from(
          bySource,
          ([from, c]) => `${c.confirmed + c.overridden} from ${baselineLabel(from)} (${c.confirmed} confirmed, ${c.overridden} overridden)`,
        );
        adoptBlock.querySelector<HTMLElement>('[data-odp-adopt-confirm-text]')!.textContent =
          `Adopt ${planned.size} decision${planned.size === 1 ? '' : 's'} as your ${baselineLabel(dashboardBaseline)} decisions: ${parts.join('; ')}? ` +
          'Each is recorded as a deliberate review and stays individually editable. The other baselines are not changed.';
        confirmEl.hidden = false;
        confirmEl.focus();
      });

      adoptBlock.querySelector('[data-odp-adopt-yes]')!.addEventListener('click', () => {
        recomputeProposals();
        if (signature(proposals) !== signature(planned)) {
          closeAdopt();
          sayAdopt('The proposals changed while you were confirming. Review the updated list and try again.');
          renderProposals(computeDashboardCounts(dashboardEntries, dashboardBaseline).overall.unreviewed);
          return;
        }
        const count = planned.size;
        const ok = adoptProposals(dashboardBaseline, planned);
        closeAdopt();
        if (!ok) {
          sayAdopt('No decision was changed. Browser storage may be full or unavailable, or a proposed override has no rationale.');
          return;
        }
        sayAdopt(`Adopted ${count} decision${count === 1 ? '' : 's'}. Each can be edited individually.`);
        refreshFromStorage();
      });

      adoptBlock.querySelector('[data-odp-adopt-no]')!.addEventListener('click', () => {
        closeAdopt();
        sayAdopt('Cancelled. Nothing was changed.');
      });
      confirmEl.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Escape') {
          closeAdopt();
          sayAdopt('Cancelled. Nothing was changed.');
        }
      });
    }
  }

  init();
</script>
