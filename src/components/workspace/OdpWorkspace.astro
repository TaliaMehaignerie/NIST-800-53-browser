    font-family: var(--font-meta);
    font-size: 13px;
    color: var(--color-ink-secondary);
  }

  .odp-workspace__rows {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 16px;
  }

  .odp-workspace__view-switcher {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 16px;
  }

  /*
   * Dedicated class, not `.odp-row__action` (found in review) — a row's
   * Confirm/Override buttons and this mutually-exclusive view switcher are
   * unrelated components that happened to look alike; sharing a class would
   * couple their future styling. Same visual treatment, `aria-selected`
   * instead of `aria-pressed` since exactly one of these three is always
   * the active view (`role="tablist"`/`role="tab"` above), not three
   * independent toggles.
   */
  .odp-workspace__view-btn {
    font-family: var(--font-meta);
    font-size: 13px;
    color: var(--color-ink-primary);
    background: var(--color-surface-overlay);
    border: none;
    border-radius: var(--rounded-sm);
    padding: 6px 14px;
    cursor: pointer;
  }

  .odp-workspace__view-btn:hover {
    background: var(--color-border-hairline);
  }

  .odp-workspace__view-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .odp-workspace__view-btn[aria-selected='true'] {
    background: var(--color-accent);
    color: var(--color-surface-base);
  }

  .odp-workspace__individual-controls {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 12px;
  }

  .odp-workspace__family-field {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .odp-workspace__family-field label {
    font-family: var(--font-meta);
    font-size: 12px;
    color: var(--color-ink-secondary);
  }

  .odp-workspace__family-field select {
    width: auto;
  }

  .odp-workspace__unreviewed-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-meta);
    font-size: 13px;
    color: var(--color-ink-primary);
  }

  .odp-workspace__batch {
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid var(--color-border-hairline);
  }

  .odp-workspace__dashboard {
    margin-top: 24px;
    padding: 16px;
    background: var(--color-surface-raised);
    border-radius: var(--rounded-md);
  }

  .odp-workspace__dashboard-heading {
    margin: 0 0 8px;
    font-size: 1.1em;
    color: var(--color-ink-primary);
  }

  .odp-dashboard__summary {
    margin: 0 0 12px;
    color: var(--color-ink-secondary);
  }

  .odp-dashboard__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9em;
    margin-bottom: 12px;
  }

  .odp-dashboard__table-caption {
    text-align: left;
    color: var(--color-ink-secondary);
    font-family: var(--font-meta);
    font-size: 12px;
    margin-bottom: 4px;
  }

  .odp-dashboard__table th,
