---
// AD-9: the single stateful island. Owns the entire ODP decision flow for
// one baseline — this story covers single-parameter set/confirm/override
// only (dash-one batching, the readiness dashboard, and OSCAL export are
// deferred to stories 2-4). No other page reads or writes a decision.
//
// Per the spec's Design Notes, the dataset is fetched client-side
// (`odp-dataset.json`) rather than via a build-time `getCollection` call in
// the route, so all row-building/filtering logic lives in one client-side
// place — this route/component only picks the baseline and mounts. Follows
// the no-framework island pattern already used by `BaselineFilter.astro` /
// `EnhancementItem.astro`: plain `<script>`, delegated listeners, no
// React/Vue/etc.
interface Props {
  baseline: 'low' | 'moderate' | 'high' | 'privacy';
}

import { reviewUrl } from '../../utils/url';

const { baseline } = Astro.props;
const baselineLabel = `${baseline[0].toUpperCase()}${baseline.slice(1)}`;
---

<section class="odp-workspace" data-odp-workspace data-baseline={baseline}>
  <h1>{baselineLabel} parameters</h1>
  <p class="odp-workspace__intro">
    Every organization-defined parameter in the {baselineLabel} baseline, in one table — useful for setting many at
    once. For a guided pass, control by control, use <a href={reviewUrl()}>Review</a>. Decisions are saved to this
    browser only.
  </p>
  <p class="odp-workspace__baseline-note" data-odp-baseline-note hidden></p>

  <div class="odp-workspace__export">
    <button type="button" class="odp-dashboard__action" data-odp-export disabled>Export OSCAL Profile</button>
    <p class="odp-workspace__export-hint">
      Decisions live only in this browser. Export regularly — this file is your durable backup copy.
    </p>
    <p class="odp-workspace__export-message" data-odp-export-message role="status" aria-live="polite">
      Loading export metadata…
    </p>
  </div>

  <p class="odp-workspace__status" data-odp-loading>Loading parameters…</p>
  <p class="odp-workspace__status" data-odp-empty hidden>No organization-defined parameters for this baseline.</p>

  <div class="odp-workspace__view-switcher" role="tablist" aria-label="Workspace view" data-odp-view-switcher hidden>
    <button
      type="button"
      role="tab"
      class="odp-workspace__view-btn"
      data-odp-view-btn="dashboard"
      aria-selected="true">Dashboard</button
    >
    <button
      type="button"
      role="tab"
      class="odp-workspace__view-btn"
      data-odp-view-btn="batch"
      aria-selected="false">Batch entry</button
    >
    <button
      type="button"
      role="tab"
      class="odp-workspace__view-btn"
      data-odp-view-btn="individual"
      aria-selected="false"
    >
      Individual parameters
    </button>
  </div>

  <div class="odp-workspace__individual-controls" data-odp-individual-controls hidden>
    <div class="odp-workspace__family-field">
      <label for="odp-family-select">Family</label>
      <select id="odp-family-select" class="odp-row__value-input" data-odp-family-select></select>
    </div>
    <label class="odp-workspace__unreviewed-toggle">
      <input type="checkbox" data-odp-unreviewed-toggle />
      Unreviewed only
    </label>
  </div>

  <div class="odp-workspace__dashboard" data-odp-dashboard hidden>
    <h2 class="odp-workspace__dashboard-heading">Readiness</h2>
    <p class="odp-dashboard__summary" data-odp-dashboard-summary></p>
    <table class="odp-dashboard__table" data-odp-dashboard-table>
      <caption class="odp-dashboard__table-caption">By family</caption>
      <thead>
        <tr>
          <th scope="col">Family</th>
          <th scope="col">Unreviewed</th>
          <th scope="col">Confirmed</th>
          <th scope="col">Overridden</th>
          <th scope="col">Total</th>
        </tr>
      </thead>
      <tbody data-odp-dashboard-tbody></tbody>
    </table>
    <div class="odp-dashboard__actions">
      <button type="button" class="odp-dashboard__action" data-odp-jump-next>Jump to next unreviewed</button>
      <button type="button" class="odp-dashboard__action" data-odp-mark-ready>Mark ready</button>
    </div>
    <p class="odp-dashboard__message" data-odp-dashboard-message role="status" aria-live="polite"></p>

    <div class="odp-proposals" data-odp-proposals hidden>
      <h3 class="odp-proposals__heading">Proposals from other baselines</h3>
      <p class="odp-proposals__text" data-odp-proposals-text></p>
      <div class="odp-dashboard__actions">
        <button type="button" class="odp-dashboard__action" data-odp-adopt-all>Review and adopt all…</button>
      </div>
      <div class="odp-proposals__confirm" role="alertdialog" tabindex="-1" hidden data-odp-adopt-confirm>
        <p><strong data-odp-adopt-confirm-text></strong></p>
        <div class="odp-dashboard__actions">
          <button type="button" class="odp-dashboard__action" data-odp-adopt-yes>Adopt</button>
          <button type="button" class="odp-dashboard__action" data-odp-adopt-no>Cancel</button>
        </div>
      </div>
      <p class="odp-proposals__status" data-odp-adopt-status role="status" aria-live="polite" hidden></p>
    </div>
  </div>

  <div class="odp-workspace__batch" data-odp-batch hidden>
    <h2 class="odp-workspace__batch-heading">Batch entry — dash-one clusters</h2>
    <p class="odp-workspace__batch-intro">
      These parameters share one value across every dash-one policy/procedure control. Set it once here — each
      control's own row below still shows and can independently override its own decision.
    </p>
    <div class="odp-workspace__rows" data-odp-batch-rows></div>
  </div>

  <div class="odp-workspace__rows" data-odp-rows></div>
</section>

<style>
  .odp-workspace__baseline-note {
    font-family: var(--font-meta);
    font-size: 13px;
    padding: 6px 10px;
    border-left: 3px solid var(--color-accent);
    background: var(--color-surface-raised);
  }

  .odp-workspace {
    padding: 24px 0;
  }

