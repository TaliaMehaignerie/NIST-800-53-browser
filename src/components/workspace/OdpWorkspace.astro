    margin: 8px 0;
  }

  .odp-row__actions {
    display: flex;
    gap: 8px;
    margin-top: 12px;
  }

  .odp-row__action {
    font-family: var(--font-meta);
    font-size: 13px;
    color: var(--color-ink-primary);
    background: var(--color-surface-overlay);
    border: none;
    border-radius: var(--rounded-sm);
    padding: 6px 14px;
    cursor: pointer;
  }

