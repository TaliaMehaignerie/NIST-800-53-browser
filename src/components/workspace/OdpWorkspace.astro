    color: var(--color-ink-secondary);
    max-width: 60ch;
  }

  .odp-workspace__status {
    font-family: var(--font-meta);
    font-size: 13px;
    color: var(--color-ink-secondary);
  }

  .odp-workspace__export {
    margin: 16px 0;
    padding: 12px 16px;
    background: var(--color-surface-raised);
    border-radius: var(--rounded-md);
  }

  .odp-workspace__export-hint {
    margin: 6px 0 0;
    font-family: var(--font-meta);
    font-size: 12px;
    color: var(--color-ink-secondary);
  }

  .odp-workspace__export-message {
