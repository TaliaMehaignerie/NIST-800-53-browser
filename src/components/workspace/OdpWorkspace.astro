---
// AD-9: the single stateful island. Owns the entire ODP decision flow for
// one baseline — this story covers single-parameter set/confirm/override
// only (dash-one batching, the readiness dashboard, and OSCAL export are
// deferred to stories 2-4). No other page reads or writes a decision.
//
// Per the spec's Design Notes, the dataset is fetched client-side
// (`odp-dataset.json`) rather than via a build-time `getCollection` call in
// the route, so all row-building/filtering logic lives in one client-side
// place — this route/component only picks the baseline and mounts. Follows
// the no-framework island pattern already used by `BaselineFilter.astro` /
// `EnhancementItem.astro`: plain `<script>`, delegated listeners, no
// React/Vue/etc.
interface Props {
  baseline: 'low' | 'moderate' | 'high' | 'privacy';
}

const { baseline } = Astro.props;
const baselineLabel = `${baseline[0].toUpperCase()}${baseline.slice(1)}`;
---

<section class="odp-workspace" data-odp-workspace data-baseline={baseline}>
  <h1>{baselineLabel} ODP Workspace</h1>
  <p class="odp-workspace__intro">
    Set, confirm, or override each organization-defined parameter for the {baselineLabel} baseline. Decisions are
    saved to this browser only.
  </p>

  <div class="odp-workspace__export">
    <button type="button" class="odp-dashboard__action" data-odp-export disabled>Export OSCAL Profile</button>
    <p class="odp-workspace__export-hint">
      Decisions live only in this browser. Export regularly — this file is your durable backup copy.
    </p>
    <p class="odp-workspace__export-message" data-odp-export-message role="status" aria-live="polite">
      Loading export metadata…
    </p>
  </div>

  <p class="odp-workspace__status" data-odp-loading>Loading parameters…</p>
  <p class="odp-workspace__status" data-odp-empty hidden>No organization-defined parameters for this baseline.</p>

  <div class="odp-workspace__dashboard" data-odp-dashboard hidden>
    <h2 class="odp-workspace__dashboard-heading">Readiness</h2>
    <p class="odp-dashboard__summary" data-odp-dashboard-summary></p>
    <table class="odp-dashboard__table" data-odp-dashboard-table>
      <caption class="odp-dashboard__table-caption">By family</caption>
      <thead>
        <tr>
          <th scope="col">Family</th>
          <th scope="col">Unreviewed</th>
          <th scope="col">Confirmed</th>
          <th scope="col">Overridden</th>
          <th scope="col">Total</th>
        </tr>
      </thead>
      <tbody data-odp-dashboard-tbody></tbody>
    </table>
    <div class="odp-dashboard__actions">
      <button type="button" class="odp-dashboard__action" data-odp-jump-next>Jump to next unreviewed</button>
      <button type="button" class="odp-dashboard__action" data-odp-mark-ready>Mark ready</button>
    </div>
    <p class="odp-dashboard__message" data-odp-dashboard-message role="status" aria-live="polite"></p>
  </div>

  <div class="odp-workspace__batch" data-odp-batch hidden>
    <h2 class="odp-workspace__batch-heading">Batch entry — dash-one clusters</h2>
    <p class="odp-workspace__batch-intro">
      These parameters share one value across every dash-one policy/procedure control. Set it once here — each
      control's own row below still shows and can independently override its own decision.
    </p>
    <div class="odp-workspace__rows" data-odp-batch-rows></div>
  </div>

  <div class="odp-workspace__rows" data-odp-rows></div>
</section>

<style>
  .odp-workspace {
    padding: 24px 0;
  }

  .odp-workspace__intro {
    color: var(--color-ink-secondary);
    max-width: 60ch;
  }

  .odp-workspace__status {
    font-family: var(--font-meta);
    font-size: 13px;
    color: var(--color-ink-secondary);
  }

  .odp-workspace__export {
    margin: 16px 0;
    padding: 12px 16px;
    background: var(--color-surface-raised);
    border-radius: var(--rounded-md);
  }

  .odp-workspace__export-hint {
    margin: 6px 0 0;
    font-family: var(--font-meta);
    font-size: 12px;
    color: var(--color-ink-secondary);
  }

  .odp-workspace__export-message {
    margin: 6px 0 0;
    font-family: var(--font-meta);
    font-size: 13px;
    color: var(--color-ink-secondary);
  }

  .odp-workspace__rows {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 16px;
  }

  .odp-workspace__batch {
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid var(--color-border-hairline);
  }

  .odp-workspace__dashboard {
    margin-top: 24px;
    padding: 16px;
    background: var(--color-surface-raised);
    border-radius: var(--rounded-md);
  }

  .odp-workspace__dashboard-heading {
    margin: 0 0 8px;
    font-size: 1.1em;
    color: var(--color-ink-primary);
  }

  .odp-dashboard__summary {
    margin: 0 0 12px;
    color: var(--color-ink-secondary);
  }

  .odp-dashboard__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9em;
    margin-bottom: 12px;
  }

  .odp-dashboard__table-caption {
    text-align: left;
    color: var(--color-ink-secondary);
    font-family: var(--font-meta);
    font-size: 12px;
    margin-bottom: 4px;
  }

  .odp-dashboard__table th,
  .odp-dashboard__table td {
    text-align: left;
    padding: 4px 8px;
    border-bottom: 1px solid var(--color-border-hairline);
    color: var(--color-ink-primary);
  }

  .odp-dashboard__actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .odp-dashboard__action {
    font-family: var(--font-meta);
    font-size: 13px;
    color: var(--color-ink-primary);
    background: var(--color-surface-overlay);
    border: none;
    border-radius: var(--rounded-sm);
    padding: 6px 14px;
    cursor: pointer;
  }

  .odp-dashboard__action:hover:not(:disabled) {
    background: var(--color-border-hairline);
  }

  .odp-dashboard__action:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }

  .odp-dashboard__action:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .odp-dashboard__message {
    margin: 8px 0 0;
    font-family: var(--font-meta);
    font-size: 13px;
    color: var(--color-ink-secondary);
  }

  .odp-workspace__batch-heading {
    margin: 0 0 4px;
    font-size: 1.1em;
    color: var(--color-ink-primary);
  }

  .odp-workspace__batch-intro {
    margin: 0;
    color: var(--color-ink-secondary);
    font-size: 0.9em;
    max-width: 70ch;
  }
</style>

<style is:global>
  .odp-row {
    background: var(--color-surface-raised);
    border-radius: var(--rounded-md);
    padding: 16px;
  }

  .odp-row__header {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }

  .odp-row__control-id {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--color-ink-secondary);
  }

  .odp-row__param-id {
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--color-ink-disabled);
  }

  .odp-row__status-label {
    margin-left: auto;
    font-family: var(--font-meta);
    font-size: 12px;
    padding: 2px 10px;
    border-radius: var(--rounded-full);
    background: var(--color-surface-overlay);
    color: var(--color-ink-secondary);
  }

  .odp-row__status-label[data-status='confirmed'] {
    color: var(--color-baseline-low);
  }

  .odp-row__status-label[data-status='overridden'] {
    color: var(--color-baseline-moderate);
  }

  .odp-row__match-label {
    margin-left: auto;
    font-family: var(--font-meta);
    font-size: 12px;
    padding: 2px 10px;
    border-radius: var(--rounded-full);
    background: var(--color-surface-overlay);
    color: var(--color-ink-secondary);
  }

  .odp-row__label {
    margin: 0 0 8px;
    color: var(--color-ink-primary);
  }

  .odp-row__guidelines {
    margin: 0 0 12px;
    padding-left: 18px;
    color: var(--color-ink-secondary);
    font-size: 0.95em;
  }

  .odp-row__guidelines:empty {
    display: none;
  }

  .odp-row__field {
    margin-bottom: 10px;
  }

  .odp-row__field label {
    display: block;
    font-family: var(--font-meta);
    font-size: 12px;
    color: var(--color-ink-secondary);
    margin-bottom: 4px;
  }

  .odp-row__value-input,
  .odp-row__rationale-input {
    width: 100%;
    box-sizing: border-box;
    background: var(--color-surface-overlay);
    color: var(--color-ink-primary);
    border: 1px solid var(--color-border-hairline);
    border-radius: var(--rounded-sm);
    padding: 6px 10px;
    font-family: var(--font-body);
    font-size: 14px;
  }

  .odp-row__value-input[multiple] {
    height: auto;
  }

  .odp-row__value-input:focus-visible,
  .odp-row__rationale-input:focus-visible,
  .odp-row__action:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .odp-row__error {
    color: var(--color-baseline-high);
    font-family: var(--font-meta);
    font-size: 13px;
    margin: 8px 0;
  }

  .odp-row__actions {
    display: flex;
    gap: 8px;
    margin-top: 12px;
  }

  .odp-row__action {
    font-family: var(--font-meta);
    font-size: 13px;
    color: var(--color-ink-primary);
    background: var(--color-surface-overlay);
    border: none;
    border-radius: var(--rounded-sm);
    padding: 6px 14px;
    cursor: pointer;
  }

  .odp-row__action:hover {
    background: var(--color-border-hairline);
  }

  .odp-row__action[aria-pressed='true'] {
    background: var(--color-accent);
    color: var(--color-surface-base);
  }
</style>

<script>
  import { getDecision, getDecisions, setDecision, type Decision, type DecisionStatus } from '../../utils/odpStore';
  import { odpDatasetUrl, odpMetaUrl } from '../../utils/url';
  import {
    groupDashOneClusters,
    computeClusterMatch,
    type Cluster,
    type OdpDatasetEntry,
  } from '../../utils/odpCluster';
  import { buildOscalProfile, downloadOscalProfile, type Baseline } from '../../utils/oscalExport';

  const STATUS_TEXT: Record<DecisionStatus, string> = {
    'unreviewed-default': 'Unreviewed',
    confirmed: 'Confirmed',
    overridden: 'Overridden',
  };

  function decisionKey(entry: OdpDatasetEntry): string {
    return `${entry.controlSlug}:${entry.paramId}`;
  }

  type ValueFieldSelect = OdpDatasetEntry['select'];

  // Shared by an individual param row and a batch cluster row — same
  // free-text/select input shape either way (spec Code Map: the batch row
  // reuses this unchanged).
  function buildValueField(
    fieldId: string,
    select: ValueFieldSelect,
    current: string | string[] | undefined,
  ): HTMLElement {
    const field = document.createElement('div');
    field.className = 'odp-row__field';
    const label = document.createElement('label');
    label.setAttribute('for', fieldId);
    label.textContent = 'Value';
    field.appendChild(label);

    if (select) {
      const isMulti = select.howMany === 'one-or-more';
      const selectEl = document.createElement('select');
      selectEl.className = 'odp-row__value-input';
      selectEl.id = fieldId;
      selectEl.dataset.odpValueInput = 'true';
      if (isMulti) {
        selectEl.multiple = true;
        selectEl.size = Math.min(select.choice.length, 6) || 1;
      } else {
        const placeholder = document.createElement('option');
        placeholder.value = '';
        placeholder.textContent = '— choose —';
        selectEl.appendChild(placeholder);
      }
      const currentValues = Array.isArray(current) ? current : current ? [current] : [];
      for (const choice of select.choice) {
        const option = document.createElement('option');
        option.value = choice;
        option.textContent = choice;
        if (currentValues.includes(choice)) option.selected = true;
        selectEl.appendChild(option);
      }
      field.appendChild(selectEl);
    } else {
      const input = document.createElement('input');
      input.type = 'text';
      input.className = 'odp-row__value-input';
      input.id = fieldId;
      input.dataset.odpValueInput = 'true';
      input.value = typeof current === 'string' ? current : '';
      field.appendChild(input);
    }

    return field;
  }

  function readValue(select: ValueFieldSelect, row: HTMLElement): string | string[] {
    const input = row.querySelector('[data-odp-value-input]') as HTMLInputElement | HTMLSelectElement;
    if (select) {
      const selectEl = input as HTMLSelectElement;
      if (select.howMany === 'one-or-more') {
        return Array.from(selectEl.selectedOptions).map((o) => o.value);
      }
      return selectEl.value;
    }
    return (input as HTMLInputElement).value;
  }

  // Re-applies a saved value to an already-rendered field, used to keep an
  // individual row's display in sync right after a batch save touches it
  // (spec manual check: no reload needed to see the fan-out).
  function setFieldValue(select: ValueFieldSelect, row: HTMLElement, value: string | string[]): void {
    const input = row.querySelector('[data-odp-value-input]') as HTMLInputElement | HTMLSelectElement;
    if (!input) return;
    if (select) {
      const values = Array.isArray(value) ? value : value ? [value] : [];
      Array.from((input as HTMLSelectElement).options).forEach((option) => {
        option.selected = values.includes(option.value);
      });
    } else {
      (input as HTMLInputElement).value = typeof value === 'string' ? value : '';
    }
  }

  function isValueEmpty(value: string | string[]): boolean {
    return Array.isArray(value) ? value.length === 0 : value.trim().length === 0;
  }

  // Individual rows register themselves here so a batch save (below) can
  // refresh an already-rendered row's display in place — no reload needed
  // to see the fan-out (spec manual checks).
  const rowRegistry = new Map<string, { row: HTMLElement; select: ValueFieldSelect }>();

  // Story 3: readiness dashboard state. `entries`/`clusters` don't change
  // after `init()` loads them — only the decisions they're read against do
  // — so they're captured once here and every dashboard refresh recomputes
  // counts fresh from `getDecision` over them (never cached, never stored;
  // spec Design Notes).
  let dashboardEntries: OdpDatasetEntry[] = [];
  let dashboardClusters: Cluster[] = [];
  let dashboardBaseline = '';

  // Story 4: OSCAL export. `oscalVersion` comes from the new build-time
  // `odp-meta.json` endpoint (AD-12) — fetched once in `init()`, never
  // hardcoded or re-derived here. Export is wired independently of the
  // dashboard/rows load path so it stays available even for a baseline with
  // zero parameters or zero decisions (spec Boundaries: never gated by the
  // readiness gate, doubles as the user's backup copy). The button starts
  // `disabled` (markup) and is only enabled once `oscalVersion` has actually
  // loaded — never clickable while it could still export an empty
  // `oscal-version` (found in review: the meta fetch is async, and the
  // button was previously enabled before or even if it failed).
  let oscalVersion = '';

  function handleExport(baseline: string): void {
    const message = document.querySelector<HTMLElement>('[data-odp-export-message]');
    try {
      const decisions = getDecisions(baseline);
      const profile = buildOscalProfile({ baseline: baseline as Baseline, decisions, oscalVersion });
      downloadOscalProfile(profile, baseline as Baseline);
      if (message) {
        const count = Object.keys(decisions).length;
        message.textContent = `Exported ${count} decision${count === 1 ? '' : 's'}.`;
      }
    } catch (err) {
      console.error('OdpWorkspace: export failed', err);
      if (message) message.textContent = 'Export failed. Please try again.';
    }
  }

  interface StatusCounts {
    unreviewed: number;
    confirmed: number;
    overridden: number;
    total: number;
  }

  function emptyStatusCounts(): StatusCounts {
    return { unreviewed: 0, confirmed: 0, overridden: 0, total: 0 };
  }

  function statusField(status: DecisionStatus): 'unreviewed' | 'confirmed' | 'overridden' {
    return status === 'unreviewed-default' ? 'unreviewed' : status;
  }

  function currentStatus(entry: OdpDatasetEntry, baseline: string): DecisionStatus {
    return getDecision(baseline, decisionKey(entry))?.status ?? 'unreviewed-default';
  }

  // Tallies overall and by-Family counts by reading every entry's status via
  // `getDecision` — a missing decision counts as `unreviewed-default`
  // (AD-10). Computed fresh on every call, never cached (spec Design Notes).
  function computeDashboardCounts(
    entries: OdpDatasetEntry[],
    baseline: string,
  ): { overall: StatusCounts; byFamily: Map<string, StatusCounts> } {
    const overall = emptyStatusCounts();
    const byFamily = new Map<string, StatusCounts>();

    for (const entry of entries) {
      const status = currentStatus(entry, baseline);
      const field = statusField(status);

      overall.total += 1;
      overall[field] += 1;

      let familyCounts = byFamily.get(entry.familyCode);
      if (!familyCounts) {
        familyCounts = emptyStatusCounts();
        byFamily.set(entry.familyCode, familyCounts);
      }
      familyCounts.total += 1;
      familyCounts[field] += 1;
    }

    return { overall, byFamily };
  }

  // First entry in document order (i.e. `entries`' own order, which is what
  // rows are built from) whose current status is `unreviewed-default`.
  function findNextUnreviewedEntry(entries: OdpDatasetEntry[], baseline: string): OdpDatasetEntry | undefined {
    return entries.find((entry) => currentStatus(entry, baseline) === 'unreviewed-default');
  }

  function findClusterForEntry(entry: OdpDatasetEntry, clusters: Cluster[]): Cluster | undefined {
    return clusters.find((cluster) =>
      cluster.members.some((m) => m.controlSlug === entry.controlSlug && m.paramId === entry.paramId),
    );
  }

  // Scrolls to and focuses the jump target: the cluster's batch row if the
  // next unreviewed entry belongs to one (`groupDashOneClusters`, story 2,
  // reused unmodified — never reimplemented here), else the entry's own row.
  function jumpToNextUnreviewed(): void {
    const next = findNextUnreviewedEntry(dashboardEntries, dashboardBaseline);
    if (!next) return;

    const cluster = findClusterForEntry(next, dashboardClusters);
    const selector = cluster
      ? `[data-odp-cluster-key="${cluster.clusterKey}"]`
      : `[data-odp-key="${decisionKey(next)}"]`;
    const target = document.querySelector<HTMLElement>(selector);
    if (!target) return;

    target.scrollIntoView({ behavior: 'smooth', block: 'center' });
    if (!target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');
    target.focus();
  }

  function handleMarkReady(): void {
    const message = document.querySelector<HTMLElement>('[data-odp-dashboard-message]');
    const { overall } = computeDashboardCounts(dashboardEntries, dashboardBaseline);
    if (!message) return;

    if (overall.unreviewed > 0) {
      message.textContent = `Not ready — ${overall.unreviewed} parameter${overall.unreviewed === 1 ? '' : 's'} still unreviewed.`;
      return;
    }

    message.textContent = `Ready — all ${overall.total} parameters reviewed.`;
  }

  // Recomputes and re-renders the whole dashboard from current decision
  // state — called on load and after every successful individual/batch save
  // so the dashboard is never stale relative to the decisions it counts
  // (spec Tasks & Acceptance).
  function refreshDashboard(): void {
    const dashboard = document.querySelector<HTMLElement>('[data-odp-dashboard]');
    if (!dashboard || dashboardEntries.length === 0) return;
    dashboard.hidden = false;

    const { overall, byFamily } = computeDashboardCounts(dashboardEntries, dashboardBaseline);

    const summary = dashboard.querySelector<HTMLElement>('[data-odp-dashboard-summary]');
    if (summary) {
      const pct = (n: number) => (overall.total > 0 ? Math.round((n / overall.total) * 100) : 0);
      summary.textContent =
        `${overall.unreviewed} unreviewed (${pct(overall.unreviewed)}%) / ` +
        `${overall.confirmed} confirmed (${pct(overall.confirmed)}%) / ` +
        `${overall.overridden} overridden (${pct(overall.overridden)}%) of ${overall.total} total`;
    }

    const tbody = dashboard.querySelector<HTMLElement>('[data-odp-dashboard-tbody]');
    if (tbody) {
      tbody.innerHTML = '';
      const families = Array.from(byFamily.keys()).sort();
      for (const family of families) {
        const counts = byFamily.get(family);
        if (!counts) continue;
        const tr = document.createElement('tr');
        const values = [
          family.toUpperCase(),
          String(counts.unreviewed),
          String(counts.confirmed),
          String(counts.overridden),
          String(counts.total),
        ];
        for (const text of values) {
          const td = document.createElement('td');
          td.textContent = text;
          tr.appendChild(td);
        }
        tbody.appendChild(tr);
      }
    }

    const jumpBtn = dashboard.querySelector<HTMLButtonElement>('[data-odp-jump-next]');
    if (jumpBtn) {
      jumpBtn.disabled = !findNextUnreviewedEntry(dashboardEntries, dashboardBaseline);
    }

    const markReadyBtn = dashboard.querySelector<HTMLButtonElement>('[data-odp-mark-ready]');
    const message = dashboard.querySelector<HTMLElement>('[data-odp-dashboard-message]');
    if (markReadyBtn) {
      markReadyBtn.disabled = overall.unreviewed > 0;
    }
    if (message) {
      message.textContent =
        overall.unreviewed > 0
          ? `Not ready — ${overall.unreviewed} parameter${overall.unreviewed === 1 ? '' : 's'} still unreviewed.`
          : '';
    }
  }

  function buildRow(entry: OdpDatasetEntry, baseline: string): HTMLElement {
    const key = decisionKey(entry);
    const existing = getDecision(baseline, key);

    const row = document.createElement('article');
    row.className = 'odp-row';
    row.dataset.odpKey = key;

    const header = document.createElement('header');
    header.className = 'odp-row__header';

    const controlSpan = document.createElement('span');
    controlSpan.className = 'odp-row__control-id';
    controlSpan.textContent = entry.controlId.toUpperCase();
    header.appendChild(controlSpan);

    const paramSpan = document.createElement('span');
    paramSpan.className = 'odp-row__param-id';
    paramSpan.textContent = entry.paramId;
    header.appendChild(paramSpan);

    const statusLabel = document.createElement('span');
    statusLabel.className = 'odp-row__status-label';
    statusLabel.dataset.odpStatusLabel = 'true';
    header.appendChild(statusLabel);

    row.appendChild(header);

    if (entry.label) {
      const labelP = document.createElement('p');
      labelP.className = 'odp-row__label';
      labelP.textContent = entry.label;
      row.appendChild(labelP);
    }

    if (entry.guidelines.length > 0) {
      const list = document.createElement('ul');
      list.className = 'odp-row__guidelines';
      for (const g of entry.guidelines) {
        const li = document.createElement('li');
        li.textContent = g;
        list.appendChild(li);
      }
      row.appendChild(list);
    }

    const fieldId = `odp-value-${entry.controlSlug}-${entry.paramId}`;
    row.appendChild(buildValueField(fieldId, entry.select, existing?.value));

    const rationaleField = document.createElement('div');
    rationaleField.className = 'odp-row__field';
    const rationaleLabel = document.createElement('label');
    const rationaleId = `odp-rationale-${entry.controlSlug}-${entry.paramId}`;
    rationaleLabel.setAttribute('for', rationaleId);
    rationaleLabel.textContent = 'Rationale (required to override)';
    rationaleField.appendChild(rationaleLabel);
    const rationaleInput = document.createElement('textarea');
    rationaleInput.className = 'odp-row__rationale-input';
    rationaleInput.id = rationaleId;
    rationaleInput.dataset.odpRationaleInput = 'true';
    rationaleInput.rows = 2;
    rationaleInput.value = existing?.rationale ?? '';
    rationaleField.appendChild(rationaleInput);
    row.appendChild(rationaleField);

    const errorP = document.createElement('p');
    errorP.className = 'odp-row__error';
    errorP.setAttribute('role', 'alert');
    errorP.hidden = true;
    errorP.dataset.odpError = 'true';
    row.appendChild(errorP);

    const actions = document.createElement('div');
    actions.className = 'odp-row__actions';
    actions.setAttribute('role', 'group');
    actions.setAttribute('aria-label', `${entry.controlId.toUpperCase()} ${entry.paramId} decision status`);

    const confirmBtn = document.createElement('button');
    confirmBtn.type = 'button';
    confirmBtn.className = 'odp-row__action';
    confirmBtn.dataset.odpAction = 'confirmed';
    confirmBtn.textContent = 'Confirm';
    confirmBtn.setAttribute('aria-pressed', 'false');
    actions.appendChild(confirmBtn);

    const overrideBtn = document.createElement('button');
    overrideBtn.type = 'button';
    overrideBtn.className = 'odp-row__action';
    overrideBtn.dataset.odpAction = 'overridden';
    overrideBtn.textContent = 'Override';
    overrideBtn.setAttribute('aria-pressed', 'false');
    actions.appendChild(overrideBtn);

    row.appendChild(actions);

    applyStatus(row, existing?.status ?? 'unreviewed-default');

    function handleAction(status: DecisionStatus) {
      const error = row.querySelector('[data-odp-error]') as HTMLElement;
      error.hidden = true;
      error.textContent = '';

      const value = readValue(entry.select, row);
      const rationale = (row.querySelector('[data-odp-rationale-input]') as HTMLTextAreaElement).value;

      if (isValueEmpty(value)) {
        error.textContent = 'Enter or select a value before saving a decision.';
        error.hidden = false;
        return;
      }

      if (status === 'overridden' && rationale.trim().length === 0) {
        error.textContent = 'A rationale is required to override a value.';
        error.hidden = false;
        return;
      }

      const decision: Decision = { value, status, rationale };
      const ok = setDecision(baseline, key, decision);
      if (!ok) {
        error.textContent =
          "Could not save this decision. If you're overriding, check the rationale is filled in; otherwise your browser storage may be full or unavailable.";
        error.hidden = false;
        return;
      }

      applyStatus(row, status);
      refreshDashboard();
    }

    confirmBtn.addEventListener('click', () => handleAction('confirmed'));
    overrideBtn.addEventListener('click', () => handleAction('overridden'));

    rowRegistry.set(key, { row, select: entry.select });

    return row;
  }

  function applyStatus(row: HTMLElement, status: DecisionStatus) {
    const statusLabel = row.querySelector('[data-odp-status-label]') as HTMLElement;
    statusLabel.textContent = STATUS_TEXT[status];
    statusLabel.dataset.status = status;

    row.querySelectorAll<HTMLButtonElement>('[data-odp-action]').forEach((btn) => {
      btn.setAttribute('aria-pressed', String(btn.dataset.odpAction === status));
    });
  }

  function refreshClusterMatch(matchLabel: HTMLElement, cluster: Cluster, baseline: string): void {
    const currentValues = cluster.members.map((m) => getDecision(baseline, `${m.controlSlug}:${m.paramId}`)?.value);
    const { matchCount, total } = computeClusterMatch(currentValues);
    matchLabel.textContent = `${matchCount}/${total} controls match this value`;
  }

  // The batch row: one per dash-one cluster (spec Tasks & Acceptance). Reuses
  // `buildValueField`/`readValue` for the same free-text/select input as an
  // individual row, and loops `setDecision` once per member — never a
  // combined or batch-tagged storage entry (AD-11). Reuses `setDecision`'s
  // own override-requires-rationale rejection rather than reimplementing
  // that check here.
  function buildBatchRow(cluster: Cluster, baseline: string): HTMLElement {
    const currentValues = cluster.members.map((m) => getDecision(baseline, `${m.controlSlug}:${m.paramId}`)?.value);
    const { majorityValue } = computeClusterMatch(currentValues);

    const row = document.createElement('article');
    row.className = 'odp-row odp-row--batch';
    row.dataset.odpClusterKey = cluster.clusterKey;

    const header = document.createElement('header');
    header.className = 'odp-row__header';

    const paramSpan = document.createElement('span');
    paramSpan.className = 'odp-row__param-id';
    paramSpan.textContent = cluster.clusterKey;
    header.appendChild(paramSpan);

    const countSpan = document.createElement('span');
    countSpan.className = 'odp-row__param-id';
    countSpan.textContent = `${cluster.members.length} dash-one controls`;
    header.appendChild(countSpan);

    const matchLabel = document.createElement('span');
    matchLabel.className = 'odp-row__match-label';
    matchLabel.dataset.odpBatchMatch = 'true';
    header.appendChild(matchLabel);

    row.appendChild(header);

    if (cluster.label) {
      const labelP = document.createElement('p');
      labelP.className = 'odp-row__label';
      labelP.textContent = cluster.label;
      row.appendChild(labelP);
    }

    if (cluster.guidelines.length > 0) {
      const list = document.createElement('ul');
      list.className = 'odp-row__guidelines';
      for (const g of cluster.guidelines) {
        const li = document.createElement('li');
        li.textContent = g;
        list.appendChild(li);
      }
      row.appendChild(list);
    }

    const fieldId = `odp-batch-value-${cluster.clusterKey}`;
    row.appendChild(buildValueField(fieldId, cluster.select, majorityValue));

    const rationaleField = document.createElement('div');
    rationaleField.className = 'odp-row__field';
    const rationaleLabel = document.createElement('label');
    const rationaleId = `odp-batch-rationale-${cluster.clusterKey}`;
    rationaleLabel.setAttribute('for', rationaleId);
    rationaleLabel.textContent = 'Rationale (required to override)';
    rationaleField.appendChild(rationaleLabel);
    const rationaleInput = document.createElement('textarea');
    rationaleInput.className = 'odp-row__rationale-input';
    rationaleInput.id = rationaleId;
    rationaleInput.dataset.odpRationaleInput = 'true';
    rationaleInput.rows = 2;
    rationaleField.appendChild(rationaleInput);
    row.appendChild(rationaleField);

    const errorP = document.createElement('p');
    errorP.className = 'odp-row__error';
    errorP.setAttribute('role', 'alert');
    errorP.hidden = true;
    errorP.dataset.odpError = 'true';
    row.appendChild(errorP);

    const actions = document.createElement('div');
    actions.className = 'odp-row__actions';
    actions.setAttribute('role', 'group');
    actions.setAttribute('aria-label', `${cluster.clusterKey} batch decision`);

    const confirmBtn = document.createElement('button');
    confirmBtn.type = 'button';
    confirmBtn.className = 'odp-row__action';
    confirmBtn.dataset.odpAction = 'confirmed';
    confirmBtn.textContent = 'Confirm';
    actions.appendChild(confirmBtn);

    const overrideBtn = document.createElement('button');
    overrideBtn.type = 'button';
    overrideBtn.className = 'odp-row__action';
    overrideBtn.dataset.odpAction = 'overridden';
    overrideBtn.textContent = 'Override';
    actions.appendChild(overrideBtn);

    row.appendChild(actions);

    refreshClusterMatch(matchLabel, cluster, baseline);

    function handleBatchAction(status: DecisionStatus) {
      const error = row.querySelector('[data-odp-error]') as HTMLElement;
      error.hidden = true;
      error.textContent = '';

      const value = readValue(cluster.select, row);
      const rationale = (row.querySelector('[data-odp-rationale-input]') as HTMLTextAreaElement).value;

      if (isValueEmpty(value)) {
        error.textContent = 'Enter or select a value before saving a decision.';
        error.hidden = false;
        return;
      }

      const decision: Decision = { value, status, rationale };

      // One independent `setDecision` call per member (AD-11) — never a
      // combined write. `setDecision`'s own rationale-required rejection is
      // reused unmodified, and since `decision` is identical for every
      // member, that specific rejection does fire for every call together
      // (checked before any storage write). A *storage-layer* failure
      // (`localStorage.setItem` throwing — quota exceeded, private mode) is
      // not guaranteed atomic the same way: it can happen partway through
      // the loop, after earlier members already wrote successfully. So on
      // any failure, still resync the display for whichever members did
      // succeed — never leave a row showing a stale value/status for a
      // decision that's actually already been persisted.
      const results = cluster.members.map((m) => ({
        member: m,
        ok: setDecision(baseline, `${m.controlSlug}:${m.paramId}`, decision),
      }));

      for (const { member, ok } of results) {
        if (!ok) continue;
        const key = `${member.controlSlug}:${member.paramId}`;
        const registered = rowRegistry.get(key);
        if (!registered) continue;
        setFieldValue(registered.select, registered.row, value);
        const memberRationaleInput = registered.row.querySelector(
          '[data-odp-rationale-input]',
        ) as HTMLTextAreaElement | null;
        if (memberRationaleInput) memberRationaleInput.value = rationale;
        applyStatus(registered.row, status);
      }

      if (!results.every((r) => r.ok)) {
        error.textContent =
          "Could not save this decision for every control. If you're overriding, check the rationale is filled in; otherwise your browser storage may be full or unavailable. Rows above now reflect what was actually saved.";
        error.hidden = false;
      }

      refreshClusterMatch(matchLabel, cluster, baseline);
      // At least one member write may have succeeded even when `results`
      // includes a failure (see comment above) — refresh regardless so the
      // dashboard never undercounts a decision that's actually persisted.
      refreshDashboard();
    }

    confirmBtn.addEventListener('click', () => handleBatchAction('confirmed'));
    overrideBtn.addEventListener('click', () => handleBatchAction('overridden'));

    return row;
  }

  async function init() {
    const workspace = document.querySelector<HTMLElement>('[data-odp-workspace]');
    if (!workspace) return;
    const baselineValue = workspace.dataset.baseline;
    if (!baselineValue) return;

    const loading = workspace.querySelector<HTMLElement>('[data-odp-loading]');
    const empty = workspace.querySelector<HTMLElement>('[data-odp-empty]');
    const rowsContainer = workspace.querySelector<HTMLElement>('[data-odp-rows]');
    const batchSection = workspace.querySelector<HTMLElement>('[data-odp-batch]');
    const batchRowsContainer = workspace.querySelector<HTMLElement>('[data-odp-batch-rows]');
    if (!rowsContainer) return;

    // The export button's click listener is wired up-front, before the
    // dataset fetch below, so it stays usable even if that fetch fails —
    // export only depends on `odp-meta.json` and whatever decisions already
    // exist in storage (spec Boundaries: always available, including with
    // zero decisions). The button itself starts `disabled` (markup) and is
    // only enabled once `oscalVersion` has actually loaded, below — clicking
    // it can never produce a document with an empty `oscal-version`.
    const exportBtn = workspace.querySelector<HTMLButtonElement>('[data-odp-export]');
    const exportMessage = workspace.querySelector<HTMLElement>('[data-odp-export-message]');
    exportBtn?.addEventListener('click', () => handleExport(baselineValue));

    try {
      const metaResponse = await fetch(odpMetaUrl());
      if (!metaResponse.ok) throw new Error(`odp-meta.json fetch failed: ${metaResponse.status}`);
      const meta = (await metaResponse.json()) as { oscalVersion: string };
      if (!meta.oscalVersion) throw new Error('odp-meta.json returned an empty oscalVersion');
      oscalVersion = meta.oscalVersion;
      if (exportBtn) exportBtn.disabled = false;
      if (exportMessage) exportMessage.textContent = '';
    } catch (err) {
      console.error('OdpWorkspace: failed to load odp-meta.json', err);
      if (exportMessage) exportMessage.textContent = 'Export is unavailable — could not load export metadata. Please reload the page.';
    }

    let dataset: OdpDatasetEntry[];
    try {
      const response = await fetch(odpDatasetUrl());
      if (!response.ok) throw new Error(`odp-dataset.json fetch failed: ${response.status}`);
      dataset = await response.json();
    } catch (err) {
      console.error('OdpWorkspace: failed to load odp-dataset.json', err);
      if (loading) loading.hidden = true;
      if (empty) {
        empty.hidden = false;
        empty.textContent = 'Unable to load parameters. Please reload the page.';
      }
      return;
    }

    const entries = dataset.filter((entry) => entry.baselines.includes(baselineValue as OdpDatasetEntry['baselines'][number]));

    if (loading) loading.hidden = true;

    if (entries.length === 0) {
      if (empty) empty.hidden = false;
      return;
    }

    // Individual rows render for every entry, dash-one included, unchanged
    // from story 1 — this is what keeps every fanned-out decision
    // independently overridable (FR-5), regardless of clustering below.
    for (const entry of entries) {
      rowsContainer.appendChild(buildRow(entry, baselineValue));
    }

    // Clustering is computed at render time only, from this baseline's
    // entries — never stored (AD-11).
    const clusters = groupDashOneClusters(entries);
    if (clusters.length > 0 && batchSection && batchRowsContainer) {
      batchSection.hidden = false;
      for (const cluster of clusters) {
        batchRowsContainer.appendChild(buildBatchRow(cluster, baselineValue));
      }
    }

    dashboardEntries = entries;
    dashboardClusters = clusters;
    dashboardBaseline = baselineValue;

    const jumpBtn = workspace.querySelector<HTMLButtonElement>('[data-odp-jump-next]');
    jumpBtn?.addEventListener('click', () => jumpToNextUnreviewed());

    const markReadyBtn = workspace.querySelector<HTMLButtonElement>('[data-odp-mark-ready]');
    markReadyBtn?.addEventListener('click', () => handleMarkReady());

    refreshDashboard();
  }

  init();
</script>
