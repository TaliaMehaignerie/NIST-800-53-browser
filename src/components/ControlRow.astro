---
// DESIGN.md "Control row": mono ID, title, Baseline badges right-aligned.
// A withdrawn entry shows the Withdrawn marker instead of badges, and its
// title renders in ink-secondary (present-but-inactive, not equal-weight).
import BaselineBadge from './BaselineBadge.astro';
import WithdrawnMarker from './WithdrawnMarker.astro';
import { controlUrl } from '../utils/url';

interface Props {
  label: string;
  title: string;
  slug: string;
  withdrawn: boolean;
  incorporatedInto: string[];
  baselines: ('low' | 'moderate' | 'high' | 'privacy')[];
}

const { label, title, slug, withdrawn, incorporatedInto, baselines } = Astro.props;
---

<a class="control-row" href={controlUrl(slug)}>
  <span class="control-row__id">{label}</span>
  <span class={`control-row__title ${withdrawn ? 'control-row__title--withdrawn' : ''}`}>{title}</span>
  <span class="control-row__badges">
    {withdrawn ? (
      <WithdrawnMarker incorporatedInto={incorporatedInto} />
    ) : baselines.length > 0 ? (
      baselines.map((b) => <BaselineBadge baseline={b} />)
    ) : (
      <span class="control-row__no-baseline">Not in a baseline</span>
    )}
  </span>
</a>

<style>
  .control-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--color-border-hairline);
    text-decoration: none;
    color: inherit;
  }

  .control-row:hover {
    background: var(--color-surface-raised);
  }

  .control-row__id {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--color-ink-secondary);
    flex-shrink: 0;
  }

  .control-row__title {
    flex: 1;
    color: var(--color-ink-primary);
  }

  .control-row__title--withdrawn {
    color: var(--color-ink-secondary);
  }

  .control-row__badges {
    display: flex;
    gap: 4px;
    flex-shrink: 0;
  }

  .control-row__no-baseline {
    font-family: var(--font-meta);
    font-size: 13px;
    color: var(--color-ink-secondary);
  }
</style>
