---
// Story 9: client overlay for the addressable `.odp-slot` spans emitted by
// StatementTree. Read-only — swaps the user's decided value in for NIST's
// resolved `[Assignment: …]`/`[Selection: …]` text, with a status treatment.
// Resolution stays build-time (AD-5); this only substitutes a stored value.
// Without JS the page keeps NIST's text. Decided values are user input, so
// they are written with textContent only, never innerHTML.
//
// Story 10: slots in the working baseline open an edit popover
// (`odpSlotPopover.ts`, which mounts `odpEdit.ts`). Its data is embedded per
// page at build time — only each control's own param label/select/guidelines,
// never the 736 KB dataset (AD-8 still applies: same Content Collection).
import type { SlotPayload } from '../utils/odpSlotPopover';

interface Props {
  payload: SlotPayload;
}

const { payload: data } = Astro.props;
// `<` escaped so embedded text can never close the script element.
const payload = JSON.stringify(data).replace(/</g, '\\u003c');
---

<script type="application/json" id="odp-slot-data" set:html={payload} is:inline />

<style is:global>
  .odp-slot[data-status] {
    text-underline-offset: 3px;
  }

  .odp-slot[data-status='unreviewed-default'] {
    text-decoration: underline dotted var(--color-ink-secondary);
  }

  .odp-slot[data-status='confirmed'] {
    color: var(--color-accent);
    text-decoration: underline solid var(--color-accent);
  }

  .odp-slot[data-status='overridden'] {
    color: var(--color-accent);
    text-decoration: underline double var(--color-accent);
  }

  .odp-slot__status {
    font-family: var(--font-meta);
    font-size: 11px;
    margin-left: 4px;
    color: var(--color-ink-secondary);
    text-decoration: none;
    display: inline-block;
  }

  .odp-slot[role='button'] {
    cursor: pointer;
  }

  .odp-slot[role='button']:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .odp-popover {
    position: absolute;
    z-index: 50;
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border-hairline);
    border-radius: var(--rounded-md);
    padding: 14px 16px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
    font-family: var(--font-meta);
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-ink-primary);
  }

  .odp-popover__title {
    font-size: 14px;
    margin: 0 0 2px;
  }

  .odp-popover__meta {
    margin: 0 0 8px;
    color: var(--color-ink-secondary);
  }

  .odp-popover__guidelines {
    margin: 0 0 8px;
    padding-left: 18px;
    color: var(--color-ink-secondary);
  }

  .odp-popover .odp-row__field {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 8px;
  }

  .odp-popover input,
  .odp-popover select,
  .odp-popover textarea {
    font: inherit;
    color: var(--color-ink-primary);
    background: var(--color-surface-overlay);
    border: 1px solid var(--color-border-hairline);
    border-radius: var(--rounded-sm);
    padding: 4px 6px;
    width: 100%;
  }

  .odp-popover__scope {
    border: 1px solid var(--color-border-hairline);
    border-radius: var(--rounded-sm);
    margin: 0 0 8px;
    padding: 6px 10px;
  }

  .odp-popover__scope legend {
    color: var(--color-ink-secondary);
    padding: 0 4px;
  }

  .odp-popover__scope-option {
    display: block;
  }

  .odp-popover__scope-option input {
    width: auto;
  }

  .odp-popover__count {
    margin: 6px 0 0;
    color: var(--color-ink-primary);
  }

  .odp-popover__error {
    color: var(--color-ink-primary);
    background: var(--color-surface-overlay);
    border-left: 3px solid var(--color-ink-secondary);
    padding: 4px 8px;
    margin: 0 0 8px;
  }

  .odp-popover__actions {
    display: flex;
    gap: 8px;
    margin-bottom: 8px;
  }

  .odp-popover__actions button {
    font: inherit;
    color: var(--color-ink-primary);
    background: var(--color-surface-overlay);
    border: none;
    border-radius: var(--rounded-sm);
    padding: 5px 12px;
    cursor: pointer;
  }

  .odp-popover__actions button:hover {
    background: var(--color-border-hairline);
  }

  .odp-popover button:focus-visible,
  .odp-popover a:focus-visible,
  .odp-popover input:focus-visible,
  .odp-popover select:focus-visible,
  .odp-popover textarea:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .odp-summary {
    font-family: var(--font-meta);
    font-size: 13px;
    color: var(--color-ink-secondary);
    margin: 0 0 16px;
  }

  .odp-summary button {
    font: inherit;
    color: var(--color-accent);
    background: none;
    border: none;
    padding: 0 0 0 8px;
    cursor: pointer;
    text-decoration: underline;
  }

  .odp-summary button:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .odp-slot-note {
    font-family: var(--font-meta);
    font-size: 13px;
    color: var(--color-ink-secondary);
    margin: 0 0 12px;
  }
</style>

<script>
  import { ACTIVE_BASELINE_EVENT, getActiveBaseline } from '../utils/activeBaseline';
  import { getDecisions } from '../utils/odpStore';
  import { onOdpStorageChange } from '../utils/storageSync';
  import { readinessFor } from '../utils/odpReadiness';
  import { readSlotPayload } from '../utils/slotPayload';
  import { closeSlotPopover, isSlotPopoverOpenFor, openSlotPopover, type SlotControl, type SlotPayload } from '../utils/odpSlotPopover';

  const pagePayload = readSlotPayload();
  const controlData: Record<string, SlotControl> = pagePayload.controls;
  const clusterData: SlotPayload['cluster'] = pagePayload.cluster;

  function makeInteractive(slot: HTMLElement, on: boolean): void {
    if (on) {
      slot.setAttribute('role', 'button');
      slot.setAttribute('tabindex', '0');
      slot.setAttribute('aria-haspopup', 'dialog');
      slot.setAttribute('aria-expanded', slot.getAttribute('aria-expanded') ?? 'false');
    } else {
      ['role', 'tabindex', 'aria-haspopup', 'aria-expanded'].forEach((a) => slot.removeAttribute(a));
    }
  }

  function openFor(slot: HTMLElement): void {
    if (slot.getAttribute('role') !== 'button') return;
    // Clicking the slot that already has the popover open toggles it off
    // instead of rebuilding it (which would discard typed input).
    if (isSlotPopoverOpenFor(slot)) {
      closeSlotPopover();
      return;
    }
    const slug = slot.dataset.controlSlug ?? '';
    const control = controlData[slug];
    if (!control) return;
    openSlotPopover({
      slot,
      control,
      controlSlug: slug,
      paramId: slot.dataset.paramId ?? '',
      baseline: getActiveBaseline(),
      cluster: clusterData,
      onSaved: () => {
        render();
        window.dispatchEvent(new CustomEvent('odpdecisionschanged'));
      },
    });
  }

  const STATUS_LABEL = { confirmed: 'confirmed', overridden: 'overridden', 'unreviewed-default': 'unreviewed' } as const;

  function valueText(value: string | string[]): string {
    return Array.isArray(value) ? value.join('; ') : value;
  }

  function resetSlot(slot: HTMLElement): void {
    if (slot.dataset.odpOriginal !== undefined) slot.textContent = slot.dataset.odpOriginal;
    delete slot.dataset.status;
    slot.removeAttribute('title');
  }

  // Per-control summary: this control plus its enhancements, counted by the
  // shared `odpCounts` tally. Jump targets the first unreviewed slot in
  // document order, expanding its enhancement if that is where it lives.
  function renderSummary(baseline: string, name: string, decisions: ReturnType<typeof getDecisions>): void {
    const summary = document.querySelector<HTMLElement>('[data-odp-summary]');
    if (!summary) return;
    const items = Object.entries(controlData).map(([slug, c]) => ({
      slug,
      baselines: c.baselines,
      paramIds: Object.keys(c.params),
    }));
    const counts = readinessFor(items, baseline, decisions);
    summary.textContent = '';
    summary.hidden = counts.total === 0;
    if (counts.total === 0) return;

    summary.append(
      document.createTextNode(
        `${counts.total} parameter${counts.total === 1 ? '' : 's'} in ${name} — ` +
          `${counts.confirmed} confirmed, ${counts.overridden} overridden, ${counts.unreviewed} unreviewed`,
      ),
    );

    const target = Array.from(document.querySelectorAll<HTMLElement>('[data-odp-slot]')).find(
      (slot) => slot.dataset.status === 'unreviewed-default',
    );
    if (target) {
      const jump = document.createElement('button');
      jump.type = 'button';
      jump.textContent = 'Jump to first unreviewed';
      jump.addEventListener('click', () => {
        const header = target.closest('.enhancement-item')?.querySelector<HTMLElement>('.enhancement-item__header');
        if (header && header.getAttribute('aria-expanded') === 'false') header.click();
        target.scrollIntoView({ block: 'center' });
        target.focus();
      });
      summary.appendChild(jump);
    }
  }

  function render(): void {
    const baseline = getActiveBaseline();
    const name = `${baseline[0].toUpperCase()}${baseline.slice(1)}`;
    const decisions = getDecisions(baseline);

    document.querySelectorAll<HTMLElement>('[data-odp-baselines]').forEach((scope) => {
      const inBaseline = (scope.dataset.odpBaselines ?? '').split(' ').includes(baseline);
      const note = scope.querySelector<HTMLElement>('[data-odp-slot-note]');
      if (note) {
        note.hidden = inBaseline;
        note.textContent = inBaseline ? '' : `Not part of the ${name} baseline — parameters shown as NIST wrote them.`;
      }

      scope.querySelectorAll<HTMLElement>('[data-odp-slot]').forEach((slot) => {
        if (slot.dataset.odpOriginal === undefined) slot.dataset.odpOriginal = slot.textContent ?? '';
        resetSlot(slot);
        makeInteractive(slot, inBaseline && Boolean(controlData[slot.dataset.controlSlug ?? '']));
        if (!inBaseline) return;

        const decision = decisions[`${slot.dataset.controlSlug}:${slot.dataset.paramId}`];
        const status = decision?.status ?? 'unreviewed-default';
        slot.dataset.status = status;
        slot.title = `${STATUS_LABEL[status]} (${name})`;
        if (decision) {
          slot.textContent = valueText(decision.value);
          const tag = document.createElement('span');
          tag.className = 'odp-slot__status';
          tag.textContent = STATUS_LABEL[status];
          slot.appendChild(tag);
        }
      });
    });

    renderSummary(baseline, name, decisions);
  }

  render();
  window.addEventListener(ACTIVE_BASELINE_EVENT, render);
  // Story 12: passive cross-tab refresh (last-write-wins otherwise).
  onOdpStorageChange(render);

  document.addEventListener('click', (e) => {
    const slot = (e.target as Element | null)?.closest?.<HTMLElement>('[data-odp-slot]');
    if (slot) openFor(slot);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter' && e.key !== ' ') return;
    const slot = (e.target as Element | null)?.closest?.<HTMLElement>('[data-odp-slot]');
    if (!slot || e.target !== slot) return;
    e.preventDefault();
    openFor(slot);
  });
</script>
