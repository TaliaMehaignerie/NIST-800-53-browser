---
// The one page shell (architecture AD-7). Ships branding, the Baseline
// filter island (CAP-2), and the provenance footer — no SearchBox markup yet
// (CAP-5 adds that as a header island later without restructuring this
// layout). Dark mode only: DESIGN.md is dark-by-default with no light-mode
// token set, so there is no `prefers-color-scheme` branch.
import ProvenanceFooter from '../components/ProvenanceFooter.astro';
import BaselineFilter from '../components/BaselineFilter.astro';
import { homeUrl } from '../utils/url';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a href={homeUrl()} class="site-title">NIST 800-53 Browser</a>
      <BaselineFilter />
    </header>
    <main>
      <slot />
    </main>
    <ProvenanceFooter />
  </body>
</html>

<style is:global>
  :root {
    --color-surface-base: #0d1117;
    --color-surface-raised: #161b22;
    --color-surface-overlay: #1c2128;
    --color-ink-primary: #e6edf3;
    --color-ink-secondary: #8b949e;
    --color-ink-disabled: #484f58;
    --color-border-hairline: #21262d;
    --color-accent: #58a6ff;
    --color-baseline-low: #3fb950;
    --color-baseline-moderate: #d29922;
    --color-baseline-high: #f85149;
    --color-baseline-privacy: #a371f7;

    --font-body: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --font-meta: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --font-mono: ui-monospace, 'SF Mono', Consolas, monospace;

    --rounded-sm: 6px;
    --rounded-md: 10px;
    --rounded-full: 9999px;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--color-surface-base);
    color: var(--color-ink-primary);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.65;
  }

  main {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 16px;
  }

  a {
    color: var(--color-accent);
  }

  /*
   * EXPERIENCE.md -> Accessibility Floor: every interactive element needs a
   * visible keyboard focus indicator using the accent color. Not optional.
   */
  a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>

<style>
  .site-header {
    max-width: 720px;
    margin: 0 auto;
    padding: 24px 16px;
  }

  .site-title {
    display: block;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 18px;
    color: var(--color-ink-primary);
    text-decoration: none;
    margin-bottom: 12px;
  }
</style>
