---
// Home (story 21): a guided start. A hero says what the tool is, a four-step
// path shows where the visitor is in it, and the family catalog (the FR-1
// browse tree root, all 20 families in catalog order) sits below it.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FamilyRow from '../components/FamilyRow.astro';
import HomeHero from '../components/HomeHero.astro';
import GettingStarted from '../components/GettingStarted.astro';

const families = (await getCollection('families')).sort((a, b) => a.data.catalogOrder - b.data.catalogOrder);
---

<BaseLayout title="NIST 800-53 Browser">
  <HomeHero />
  <GettingStarted />
  <h2 class="browse-heading">Browse the catalog</h2>
  <p class="browse-lead">All 20 control families, read-only and verbatim from NIST.</p>
  <div class="family-list">
    {
      families.map((family) => (
        <FamilyRow
          code={family.data.code}
          name={family.data.name}
          controlCount={family.data.controlCount}
          slug={family.data.slug}
        />
      ))
    }
  </div>
</BaseLayout>
