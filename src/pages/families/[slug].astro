---
// Family page (AD-1 static): Controls in catalog order via `controlSlugs`.
//
// Intentionally no data-pagefind-filter/-meta here (spec
// spec-search-baseline-integration): Families aren't Baseline-tagged
// entities, only Controls/Enhancements are (AD-2). A Family search result on
// /search always shows no Baseline badge and disappears whenever a specific
// Baseline filter is active on /search -- accepted, not a bug.
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ControlRow from '../../components/ControlRow.astro';
import FamilyReadiness from '../../components/FamilyReadiness.astro';
import BulkNotApplicable from '../../components/BulkNotApplicable.astro';
import { homeUrl } from '../../utils/url';

export async function getStaticPaths() {
  const families = await getCollection('families');
  return families.map((family) => ({
    params: { slug: family.data.slug },
    props: { family },
  }));
}

const { family } = Astro.props;

const controls = (
  await Promise.all(family.data.controlSlugs.map((slug: string) => getEntry('controls', slug)))
).filter((c): c is NonNullable<typeof c> => c !== undefined);

// Story 12: each row's readiness rolls up the control and its enhancements.
const readinessItems: Record<string, { slug: string; baselines: string[]; paramIds: string[] }[]> = {};
// Story 19: every non-withdrawn item (control or enhancement) in the family, for bulk not-applicable.
const bulkItems: { slug: string; label: string; baselines: string[] }[] = [];
for (const control of controls) {
  if (control.data.withdrawn) continue;
  const enhancements = (
    await Promise.all(control.data.enhancementSlugs.map((slug: string) => getEntry('controls', slug)))
  ).filter((e): e is NonNullable<typeof e> => e !== undefined && !e.data.withdrawn);
  for (const e of [control, ...enhancements]) {
    bulkItems.push({ slug: e.data.slug, label: e.data.label, baselines: e.data.baselines as string[] });
  }
  const items = [control, ...enhancements]
    .filter((e) => e.data.params.length > 0)
    .map((e) => ({
      slug: e.data.slug,
      baselines: e.data.baselines as string[],
      paramIds: e.data.params.map((p: { id: string }) => p.id),
    }));
  if (items.length > 0) readinessItems[control.data.slug] = items;
}
---

<BaseLayout title={`${family.data.code} — ${family.data.name} — NIST 800-53 Browser`} showBaselineFilter>
  <a class="back-link" href={homeUrl()}>← Home</a>
  <h1>{family.data.code} — {family.data.name}</h1>
  <div class="control-list">
    {
      controls.map((control) => (
        <ControlRow
          label={control.data.label}
          title={control.data.title}
          slug={control.data.slug}
          withdrawn={control.data.withdrawn}
          incorporatedInto={control.data.incorporatedInto}
          baselines={control.data.baselines}
          programWide={!control.data.withdrawn && control.data.baselines.length === 0 && control.data.familyCode === 'PM'}
        />
      ))
    }
  </div>
  <p class="baseline-empty-state" hidden>No controls match this Baseline.</p>
  <FamilyReadiness items={readinessItems} />
  <BulkNotApplicable familyCode={family.data.code} items={bulkItems} />
</BaseLayout>

<style>
  .back-link {
    display: inline-block;
    font-family: var(--font-meta);
    font-size: 13px;
    color: var(--color-ink-secondary);
    text-decoration: none;
    margin-bottom: 12px;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .baseline-empty-state {
    font-family: var(--font-meta);
    font-size: 13px;
    color: var(--color-ink-secondary);
    padding: 12px 16px;
  }
</style>
