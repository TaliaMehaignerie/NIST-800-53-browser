---
// Search results page (CAP-5, architecture AD-7). Reads `?q=` server-side
// only to pre-fill SearchBox's initial HTML value (via BaseLayout's
// searchQuery prop) -- everything after that is client-side Pagefind
// (AD-1: no server-side search execution). BaselineFilter renders inert
// here (filterInert) per DESIGN.md's explicit carve-out -- it has nothing
// to filter on this page.
import BaseLayout from '../layouts/BaseLayout.astro';

const query = Astro.url.searchParams.get('q') ?? '';
---

<BaseLayout title="Search — NIST 800-53 Browser" filterInert searchQuery={query}>
  <div data-pagefind-ignore>
    <!--
      This page's own content shouldn't be indexed: its "Search" heading and
      (empty, client-rendered) results container add no useful searchable
      text, and classify() in SearchBox.astro already filters out any
      /search/ URL from rendered results regardless -- this is belt-and-
      suspenders to keep the index itself free of a self-referential entry.
    -->
    <h1>Search</h1>
    <p id="search-status" class="search-status" aria-live="polite"></p>
    <ul id="search-list" class="search-list"></ul>
  </div>
</BaseLayout>

<style>
  .search-status {
    font-family: var(--font-meta);
    font-size: 13px;
    color: var(--color-ink-secondary);
    margin: 0 0 4px;
    padding: 10px 0 0;
  }

  .search-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>

<style is:global>
  .search-result {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--color-border-hairline);
    text-decoration: none;
    color: inherit;
  }

  .search-result:hover {
    background: var(--color-surface-raised);
  }

  .search-result__id {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--color-ink-secondary);
    flex-shrink: 0;
  }

  .search-result__title {
    color: var(--color-ink-primary);
  }
</style>
