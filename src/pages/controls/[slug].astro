---
// Control Detail page (AD-1 static, AD-4: enhancements never get their own
// route — they render as fragments here). ISO Crosswalk (CAP-4) renders real
// data per DESIGN.md's ISO Crosswalk entry: code-only mono pills, no titles.
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BaselineBadge from '../../components/BaselineBadge.astro';
import WithdrawnMarker from '../../components/WithdrawnMarker.astro';
import StatementTree from '../../components/StatementTree.astro';
import EnhancementItem from '../../components/EnhancementItem.astro';
import { familyUrl } from '../../utils/url';

export async function getStaticPaths() {
  const allEntries = await getCollection('controls');
  const controls = allEntries.filter((c) => c.data.kind === 'control');
  return controls.map((control) => ({
    params: { slug: control.data.slug },
    props: { control },
  }));
}

const { control } = Astro.props;
const {
  label,
  title,
  withdrawn,
  incorporatedInto,
  baselines,
  statement,
  guidance,
  enhancementSlugs,
  crosswalk,
  familyCode,
  params,
} = control.data;

const crosswalkHasPartialMatch = crosswalk.some((code: string) => code.endsWith('*'));

const family = await getEntry('families', familyCode.toLowerCase());

const enhancements = (
  await Promise.all(enhancementSlugs.map((slug: string) => getEntry('controls', slug)))
).filter((e): e is NonNullable<typeof e> => e !== undefined);
---

<BaseLayout title={`${label} ${title} — NIST 800-53 Browser`} showBaselineFilter>
  {family && (
    <a class="back-link" href={familyUrl(family.data.slug)}>← {family.data.code} — {family.data.name}</a>
  )}
  <article class="control-detail-card">
    <h1 data-pagefind-meta={!withdrawn && baselines.length > 0 ? `baselines:${baselines.join(',')}` : undefined}>
      {label} {title}
    </h1>
    {
      /*
       * data-pagefind-filter takes exactly one key:value pair per element --
       * it splits on the first colon and treats everything after as the
       * literal value, commas included, so a single element can't carry
       * multiple Baseline values (confirmed empirically via pagefind.filters()
       * live output; a comma-joined value produced one bogus combined-string
       * facet value per Control instead of three independent ones). Each
       * value needs its own element; Pagefind aggregates per-page across all
       * elements within data-pagefind-body scope.
       *
       * Gated on `!withdrawn` even though a withdrawn Control's `baselines`
       * is always empty in real data today (verified: 0 occurrences) --
       * this keeps search filtering/faceting in sync with what the page
       * itself visually shows (a Withdrawn marker, never Baseline badges)
       * if that ever changed, rather than relying on an incidental guarantee
       * from the ingestion layer.
       */
    }
    {!withdrawn && baselines.map((b: string) => <span data-pagefind-filter={`baseline:${b}`} />)}
    <div class="control-detail-card__badges">
      {withdrawn ? (
        <WithdrawnMarker incorporatedInto={incorporatedInto} showSuccessors />
      ) : baselines.length > 0 ? (
        baselines.map((b) => <BaselineBadge baseline={b} />)
      ) : (
        <span class="control-detail-card__no-baseline">Not in a baseline</span>
      )}
    </div>

    {statement.length > 0 && (
      <div class="control-detail-card__statement">
        <StatementTree nodes={statement} params={params} />
      </div>
    )}

    {guidance && (
      <section class="control-detail-card__discussion">
        <h2>Discussion</h2>
        <p>{guidance}</p>
      </section>
    )}

    {enhancements.length > 0 && (
      <section class="control-detail-card__enhancements">
        <h2>Enhancements</h2>
        <div class="enhancement-list">
          {
            enhancements.map((e) => (
              <EnhancementItem
                slug={e.data.slug}
                label={e.data.label}
                title={e.data.title}
                withdrawn={e.data.withdrawn}
                incorporatedInto={e.data.incorporatedInto}
                baselines={e.data.baselines}
                statement={e.data.statement}
                guidance={e.data.guidance}
                params={e.data.params}
              />
            ))
          }
        </div>
        <p class="baseline-empty-state" hidden>No Enhancements match this Baseline.</p>
      </section>
    )}

    <section class="control-detail-card__crosswalk">
      <h2>ISO/IEC 27001:2022 Crosswalk</h2>
      {crosswalk.length > 0 ? (
        <>
          <div class="crosswalk-pills">
            {crosswalk.map((code: string) => <span class="crosswalk-pill">{code}</span>)}
          </div>
          {crosswalkHasPartialMatch && (
            <p class="crosswalk-legend">* does not fully satisfy the intent of this control (per NIST's mapping notes).</p>
          )}
        </>
      ) : (
        <p class="control-detail-card__crosswalk-empty">No ISO 27001 mapping published for this control.</p>
      )}
    </section>
  </article>
</BaseLayout>

<style>
  .back-link {
    display: inline-block;
    font-family: var(--font-meta);
    font-size: 13px;
    color: var(--color-ink-secondary);
    text-decoration: none;
    margin-bottom: 12px;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .control-detail-card {
    background: var(--color-surface-raised);
    border-radius: var(--rounded-md);
    padding: 24px;
    margin: 24px 0;
  }

  .control-detail-card__badges {
    display: flex;
    gap: 4px;
    margin-bottom: 16px;
  }

  .control-detail-card__statement {
    margin-bottom: 24px;
  }

  .control-detail-card__enhancements h2,
  .control-detail-card__crosswalk h2,
  .control-detail-card__discussion h2 {
    font-size: 1.1em;
  }

  .control-detail-card__discussion {
    margin-bottom: 24px;
  }

  .control-detail-card__discussion p {
    color: var(--color-ink-secondary);
  }

  .control-detail-card__crosswalk-empty {
    font-family: var(--font-meta);
    font-size: 13px;
    color: var(--color-ink-secondary);
  }

  .crosswalk-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .crosswalk-pill {
    display: inline-block;
    background: var(--color-surface-overlay);
    color: var(--color-ink-primary);
    border-radius: var(--rounded-full);
    font-family: var(--font-mono);
    font-size: 0.9em;
    padding: 2px 8px;
  }

  .crosswalk-legend {
    font-family: var(--font-meta);
    font-size: 13px;
    color: var(--color-ink-secondary);
    margin-top: 8px;
  }

  .control-detail-card__no-baseline {
    font-family: var(--font-meta);
    font-size: 13px;
    color: var(--color-ink-secondary);
  }

  .baseline-empty-state {
    font-family: var(--font-meta);
    font-size: 13px;
    color: var(--color-ink-secondary);
  }
</style>
